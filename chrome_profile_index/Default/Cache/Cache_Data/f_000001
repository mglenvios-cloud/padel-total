        <button class="btn-primary" onclick="startGame('tournament')">⚡ JUGAR PARTIDO</button>
      </div>

      <div class="tab-panel" id="tourn-copa">
        <p style="color:var(--muted);font-size:0.82rem;margin-bottom:16px;">Eliminación directa · 8 equipos</p>
        <div class="card">
          <div class="bracket-wrap" id="bracket-wrap"></div>
        </div>
      </div>

      <div class="tab-panel" id="tourn-mundial">
        <div class="card mundial-overlay" style="min-height:300px;position:relative;overflow:hidden;">
          <div style="padding:20px;opacity:0.3;">
            <p style="font-family:'Orbitron',sans-serif;font-size:1.1rem;text-align:center;letter-spacing:0.2em;margin-top:60px;">🌍 MUNDIAL DE PÁDEL</p>
            <p style="text-align:center;color:var(--muted);margin-top:8px;">64 países · 512 jugadores</p>
          </div>
          <div class="lock-overlay">
            <span class="lock-icon">🔒</span>
            <span class="lock-msg">Próximamente</span>
            <span class="lock-sub">Necesitas alcanzar el Nivel 10+ para desbloquear</span>
          </div>
        </div>
      </div>

      <div class="tab-panel" id="tourn-carrera">
        <div class="career-path" id="career-path"></div>
      </div>
    </div>
  </div>

  <!-- ═══ SCREEN 5 – RANKINGS ═══ -->
  <div id="screen-rankings" class="screen">
    <div style="max-width:800px;margin:0 auto;padding-top:10px;">
      <div class="screen-header">
        <button class="btn-back" onclick="goBack()">← Volver</button>
        <h2 class="screen-title">Ranking Mundial</h2>
      </div>

      <div class="tabs">
        <button class="tab-btn active" onclick="switchTab('rank','global',this)">🌍 Global</button>
        <button class="tab-btn" onclick="switchTab('rank','nacional',this)">🏴 Nacional</button>
        <button class="tab-btn" onclick="switchTab('rank','nivel',this)">⭐ Por Nivel</button>
      </div>

      <div class="tab-panel active" id="rank-global">
        <div class="card" style="padding:0;overflow:hidden;">
          <table class="data-table">
            <thead><tr><th style="width:40px;">#</th><th>Jugador</th><th style="width:40px;">País</th><th style="width:50px;">Niv</th><th style="width:50px;">V</th><th style="width:50px;">D</th><th style="width:70px;">Pts</th></tr></thead>
            <tbody id="rank-body-global"></tbody>
          </table>
        </div>
      </div>

      <div class="tab-panel" id="rank-nacional">
        <div class="card" style="padding:0;overflow:hidden;">
          <table class="data-table">
            <thead><tr><th>#</th><th>Jugador</th><th>País</th><th>Niv</th><th>V</th><th>D</th><th>Pts</th></tr></thead>
            <tbody id="rank-body-nacional"></tbody>
          </table>
        </div>
      </div>

      <div class="tab-panel" id="rank-nivel">
        <div class="card" style="padding:0;overflow:hidden;">
          <table class="data-table">
            <thead><tr><th>#</th><th>Jugador</th><th>País</th><th>Niv</th><th>V</th><th>D</th><th>Pts</th></tr></thead>
            <tbody id="rank-body-nivel"></tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <!-- ═══ SCREEN 6 – SETTINGS ═══ -->
  <div id="screen-settings" class="screen">
    <div style="max-width:700px;margin:0 auto;padding-top:10px;">
      <div class="screen-header">
        <button class="btn-back" onclick="goBack()">← Volver</button>
        <h2 class="screen-title">Ajustes</h2>
      </div>

      <div class="settings-section">
        <div class="settings-section-title">🔊 Audio</div>
        <div class="settings-panel">
          <div class="slider-row">
            <span>Volumen General</span>
            <input type="range" min="0" max="100" value="75" id="vol-general"
              oninput="document.getElementById('vol-general-val').textContent=this.value;saveSetting('volGeneral',this.value)">
            <span class="slider-val" id="vol-general-val">75</span>
          </div>
          <div class="toggle-wrap">
            <span>Efectos de Sonido</span>
            <label class="toggle"><input type="checkbox" checked id="toggle-sfx" onchange="saveSetting('sfx',this.checked)"><span class="toggle-slider"></span></label>
          </div>
          <div class="toggle-wrap">
            <span>Público / Ambiente</span>
            <label class="toggle"><input type="checkbox" checked id="toggle-crowd" onchange="saveSetting('crowd',this.checked)"><span class="toggle-slider"></span></label>
          </div>
          <div class="toggle-wrap">
            <span>Música de Fondo</span>
            <label class="toggle"><input type="checkbox" checked id="toggle-music" onchange="saveSetting('music',this.checked)"><span class="toggle-slider"></span></label>
          </div>
        </div>
      </div>

      <div class="settings-section">
        <div class="settings-section-title">🖥️ Gráficos</div>
        <div class="settings-panel">
          <div style="margin-bottom:12px;">
            <div style="font-size:0.85rem;color:var(--muted);margin-bottom:8px;">Calidad de Gráficos</div>
            <div class="quality-btns">
              <button class="quality-btn" onclick="setQuality('low',this)">Baja</button>
              <button class="quality-btn active" onclick="setQuality('medium',this)">Media</button>
              <button class="quality-btn" onclick="setQuality('high',this)">Alta</button>
            </div>
          </div>
          <div class="toggle-wrap">
            <span>Sombras</span>
            <label class="toggle"><input type="checkbox" checked id="toggle-shadows" onchange="saveSetting('shadows',this.checked)"><span class="toggle-slider"></span></label>
          </div>
          <div class="toggle-wrap">
            <span>Efectos de Partículas</span>
            <label class="toggle"><input type="checkbox" checked id="toggle-particles-setting" onchange="saveSetting('particles',this.checked)"><span class="toggle-slider"></span></label>
          </div>
        </div>
      </div>

      <div class="settings-section">
        <div class="settings-section-title">🎮 Controles</div>
        <div class="settings-panel">
          <table class="keybinds-table">
            <tr><td>Moverse</td><td><span class="key-badge">W A S D</span> / <span class="key-badge">↑ ↓ ← →</span></td></tr>
            <tr><td>Golpe Normal</td><td><span class="key-badge">ESPACIO</span></td></tr>
            <tr><td>Globo / Lob</td><td><span class="key-badge">Q</span></td></tr>
            <tr><td>Volea / Remate</td><td><span class="key-badge">E</span></td></tr>
            <tr><td>Pausa</td><td><span class="key-badge">ESC</span></td></tr>
            <tr><td>Cambiar Cámara</td><td><span class="key-badge">C</span></td></tr>
          </table>
          <div style="margin-top:12px;padding:10px;background:rgba(33,150,243,0.07);border-radius:10px;border:1px solid rgba(33,150,243,0.2);">
            <p style="font-size:0.8rem;color:var(--blue);">📱 Móvil: Joystick virtual izquierdo para moverse · Botones derecha para golpes</p>
          </div>
        </div>
      </div>

      <div class="settings-section">
        <div class="settings-section-title">🌐 Idioma</div>
        <div class="settings-panel">
          <div class="lang-btns">
            <button class="lang-btn active" id="lang-es" onclick="setLang('es',this)">🇪🇸 Español</button>
            <button class="lang-btn" id="lang-en" onclick="setLang('en',this)">🇺🇸 English</button>
          </div>
        </div>
      </div>

      <div class="settings-section">
        <div class="settings-section-title">⚠️ Datos</div>
        <div class="settings-panel">
          <button class="btn-secondary" style="border-color:rgba(244,67,54,0.4);color:var(--red);" onclick="resetData()">🗑️ Borrar todos los datos</button>
        </div>
      </div>
    </div>
  </div>

  <script>
    /* ═══ STATE ═══ */
    let screenHistory      = ['screen-main'];
    let selectedMode       = 'quick';
    let selectedDifficulty = 3;
    let selectedCourt      = 'indoor';
    let selectedRacket     = 0;
    let selectedOutfit     = 0;

    const SK = {
      PLAYER:   'padelPlayerData',
      SETTINGS: 'padelSettings',
      MATCH:    'padelMatchConfig',
      STATS:    'padelStats'
    };

    /* ═══ NAVIGATION ═══ */
    function showScreen(id) {
      document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
      document.getElementById(id).classList.add('active');
      if (id !== screenHistory[screenHistory.length - 1]) screenHistory.push(id);
      if (id === 'screen-player')     populatePlayerForm();
      if (id === 'screen-rankings')   generateRankings();
      if (id === 'screen-tournament') buildTournament();
    }
    function goBack() {
      if (screenHistory.length > 1) {
        screenHistory.pop();
        showScreen(screenHistory[screenHistory.length - 1]);
      }
    }

    /* ═══ TABS ═══ */
    function switchTab(group, tab, btn) {
      document.querySelectorAll(`[id^="${group}-"]`).forEach(p => p.classList.remove('active'));
      const t = document.getElementById(`${group}-${tab}`);
      if (t) t.classList.add('active');
      btn.closest('.tabs').querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
    }

    /* ═══ TOAST ═══ */
    function showToast(msg, type = 'info') {
      const el = document.createElement('div');
      el.className = `toast toast-${type}`;
      el.textContent = msg;
      document.getElementById('toast-container').appendChild(el);
      requestAnimationFrame(() => setTimeout(() => el.classList.add('show'), 10));
      setTimeout(() => { el.classList.remove('show'); setTimeout(() => el.remove(), 400); }, 3000);
    }

    /* ═══ PARTICLES ═══ */
    function spawnParticles() {
      const c = document.getElementById('particles');
      for (let i = 0; i < 14; i++) {
        const b = document.createElement('div');
        b.className = 'particle';
        b.style.left = (Math.random() * 100) + '%';
        b.style.animationDelay = (Math.random() * 10) + 's';
        b.style.animationDuration = (7 + Math.random() * 9) + 's';
        const sz = 6 + Math.random() * 10;
        b.style.width = b.style.height = sz + 'px';
        c.appendChild(b);
      }
    }

    /* ═══ STORAGE ═══ */
    function loadPlayer() {
      try { return JSON.parse(localStorage.getItem(SK.PLAYER)); } catch { return null; }
    }
    function loadStats() {
      try { return JSON.parse(localStorage.getItem(SK.STATS)) || { w:0, l:0, xp:0, level:1 }; }
      catch { return { w:0, l:0, xp:0, level:1 }; }
    }

    /* ═══ PLAYER ═══ */
    function savePlayer() {
      const name = document.getElementById('player-name').value.trim();
      if (!name) { showToast('Escribe tu nombre primero', 'warning'); return; }
      const stats = loadStats();
      const data  = {
        name,
        age:         parseInt(document.getElementById('player-age').value) || 25,
        nationality: document.getElementById('player-nationality').value,
        hand:        document.querySelector('.hand-btn.active')?.dataset.hand || 'right',
        style:       document.getElementById('player-style').value,
        racket:      selectedRacket,
        outfit:      selectedOutfit,
        xp:          stats.xp,
        level:       stats.level
      };
      localStorage.setItem(SK.PLAYER, JSON.stringify(data));
      showToast('¡Jugador guardado con éxito!', 'success');
      updateMainGreeting(data);
      updateAvatarDisplay(data);
    }

    function updateAvatarPreview() {
      const val = document.getElementById('player-name').value.trim();
      const ini = val ? val.split(' ').map(w => w[0]).join('').substring(0,2).toUpperCase() : '?';
      document.getElementById('avatar-display').textContent = ini;
      document.getElementById('avatar-name').textContent   = val || 'Nuevo Jugador';
    }

    function updateAvatarDisplay(p) {
      if (!p) return;
      const ini = p.name.split(' ').map(w => w[0]).join('').substring(0,2).toUpperCase();
      document.getElementById('avatar-display').textContent = ini;
      document.getElementById('avatar-name').textContent   = p.name;
    }

    function populatePlayerForm() {
      const p     = loadPlayer();
      const stats = loadStats();
      if (p) {
        document.getElementById('player-name').value      = p.name || '';
        document.getElementById('player-age').value       = p.age  || 25;
        document.getElementById('player-nationality').value = p.nationality || 'AR';
        document.getElementById('player-style').value     = p.style || 'balanced';
        document.querySelectorAll('.hand-btn').forEach(b => b.classList.toggle('active', b.dataset.hand === (p.hand||'right')));
        document.querySelectorAll('.racket-card').forEach((c,i) => c.classList.toggle('selected', i === (p.racket||0)));
        document.querySelectorAll('.swatch').forEach((s,i) => s.classList.toggle('selected', i === (p.outfit||0)));
        selectedRacket = p.racket || 0;
        selectedOutfit = p.outfit || 0;
        updateAvatarDisplay(p);
      }
      const level  = stats.level || 1;
      const xp     = stats.xp    || 0;
      const xpMax  = level * 1000;
      const pct    = Math.min(100, Math.round((xp / xpMax) * 100));
      document.getElementById('avatar-level').textContent = `LVL ${level}`;
      document.getElementById('xp-label').textContent     = `${xp} / ${xpMax} XP`;
      document.getElementById('xp-bar').style.width       = pct + '%';
      document.getElementById('stat-w').textContent       = stats.w || 0;
      document.getElementById('stat-l').textContent       = stats.l || 0;
      const tot = (stats.w||0) + (stats.l||0);
      document.getElementById('stat-eff').textContent     = tot > 0 ? Math.round(((stats.w||0)/tot)*100)+'%' : '0%';
    }

    function updateMainGreeting(p) {
      const el = document.getElementById('player-greeting');
      if (p && p.name) el.innerHTML = `Bienvenido/a, <span class="player-name-highlight">${p.name}</span>`;
      else el.textContent = 'Crea tu jugador para comenzar';
    }

    /* ═══ GAME MODES ═══ */
    function selectMode(mode, el) {
      selectedMode = mode;
      document.querySelectorAll('.mode-card').forEach(c => c.classList.remove('selected'));
      el.classList.add('selected');
    }
    function setDifficulty(val) {
      selectedDifficulty = val;
      document.querySelectorAll('.star').forEach((s,i) => s.classList.toggle('active', i < val));
    }
    function setCourt(type) {
      selectedCourt = type;
      document.getElementById('court-indoor').classList.toggle('active', type === 'indoor');
      document.getElementById('court-outdoor').classList.toggle('active', type === 'outdoor');
    }
    function startGame(mode) {
      const p = loadPlayer();
      if (!p || !p.name) {
        showToast('¡Crea tu jugador primero!', 'warning');
        document.getElementById('modes-warning').style.display = 'block';
        setTimeout(() => showScreen('screen-player'), 1400);
        return;
      }
      localStorage.setItem(SK.MATCH, JSON.stringify({ mode: mode || selectedMode, difficulty: selectedDifficulty, court: selectedCourt }));
      showToast('¡Cargando partida...', 'info');
      setTimeout(() => { window.location.href = 'game.html'; }, 800);
    }

    /* ═══ PLAYER CHOICES ═══ */
    function setHand(hand, el) {
      document.querySelectorAll('.hand-btn').forEach(b => b.classList.remove('active'));
      el.classList.add('active');
    }
    function selectRacket(idx, el) {
      selectedRacket = idx;
      document.querySelectorAll('.racket-card').forEach(c => c.classList.remove('selected'));
      el.classList.add('selected');
    }
    function selectOutfit(idx, el) {
      selectedOutfit = idx;
      document.querySelectorAll('.swatch').forEach(s => s.classList.remove('selected'));
      el.classList.add('selected');
    }

    /* ═══ RANKINGS DATA ═══ */
    const AI_PLAYERS = [
      { name:'Carlos Fernández',  flag:'🇦🇷', nat:'AR', level:98, w:312, l:45,  pts:4521 },
      { name:'Miguel Lamperti',   flag:'🇦🇷', nat:'AR', level:95, w:298, l:52,  pts:4312 },
      { name:'Juan Martín Díaz',  flag:'🇪🇸', nat:'ES', level:93, w:287, l:61,  pts:4198 },
      { name:'Fernando Beltrán',  flag:'🇪🇸', nat:'ES', level:91, w:271, l:69,  pts:3987 },
      { name:'Pablo Lima',        flag:'🇧🇷', nat:'BR', level:89, w:255, l:75,  pts:3801 },
      { name:'Alejandro Galán',   flag:'🇪🇸', nat:'ES', level:88, w:243, l:82,  pts:3654 },
      { name:'Juan Lebrón',       flag:'🇪🇸', nat:'ES', level:86, w:231, l:91,  pts:3498 },
      { name:'Matías Torres',     flag:'🇦🇷', nat:'AR', level:84, w:218, l:99,  pts:3321 },
      { name:'Rodrigo Gutierrez', flag:'🇲🇽', nat:'MX', level:82, w:204, l:108, pts:3145 },
      { name:'Lucas Bergamasco',  flag:'🇮🇹', nat:'IT', level:80, w:189, l:117, pts:2967 },
      { name:'Antoine Salazar',   flag:'🇫🇷', nat:'FR', level:78, w:175, l:126, pts:2789 },
      { name:'Marco Ferretti',    flag:'🇮🇹', nat:'IT', level:76, w:162, l:135, pts:2612 },
      { name:'Sebastián Moreno',  flag:'🇨🇱', nat:'CL', level:74, w:149, l:144, pts:2435 },
      { name:'Diego Castellano',  flag:'🇺🇾', nat:'UY', level:72, w:136, l:153, pts:2258 },
      { name:'Nicolás Pavón',     flag:'🇦🇷', nat:'AR', level:70, w:124, l:162, pts:2081 },
      { name:'James Harrison',    flag:'🇬🇧', nat:'GB', level:68, w:112, l:171, pts:1904 },
      { name:'Pedro Vasquez',     flag:'🇵🇹', nat:'PT', level:66, w:100, l:180, pts:1727 },
      { name:'Erik Lindström',    flag:'🇸🇪', nat:'SE', level:64, w:89,  l:189, pts:1550 },
      { name:'Andrei Popescu',    flag:'🇷🇴', nat:'RO', level:62, w:78,  l:198, pts:1373 }
    ];

    const NAT_FLAG = {
      AR:'🇦🇷',ES:'🇪🇸',BR:'🇧🇷',MX:'🇲🇽',UY:'🇺🇾',CL:'🇨🇱',
      PY:'🇵🇾',PE:'🇵🇪',CO:'🇨🇴',VE:'🇻🇪',US:'🇺🇸',GB:'🇬🇧',
      FR:'🇫🇷',IT:'🇮🇹',DE:'🇩🇪',AU:'🇦🇺',PT:'🇵🇹',NL:'🇳🇱',
      BE:'🇧🇪',SE:'🇸🇪',RO:'🇷🇴'
    };

    function getPlayerRow() {
      const p = loadPlayer(); const s = loadStats();
      if (!p) return null;
      return { name: p.name, flag: NAT_FLAG[p.nationality] || '🏳️', nat: p.nationality,
               level: s.level || 1, w: s.w || 0, l: s.l || 0,
               pts: (s.w||0)*15 + (s.level||1)*10, isPlayer: true };
    }

    function buildRankTable(tbodyId, rows) {
      const tbody = document.getElementById(tbodyId);
      if (!tbody) return;
      const medals = ['🥇','🥈','🥉'];
      tbody.innerHTML = rows.map((r, i) => {
        const medal = i < 3 ? `<span class="rank-medal">${medals[i]}</span>` : '';
        const cls   = r.isPlayer ? 'player-row' : i===0 ? 'rank-gold' : i===1 ? 'rank-silver' : i===2 ? 'rank-bronze' : '';
        const nameStr = r.isPlayer ? `<strong style="color:var(--primary);">▶ ${r.name}</strong>` : r.name;
        return `<tr class="${cls}">
          <td>${medal}<span class="rank-num">${i+1}</span></td>
          <td>${nameStr}</td>
          <td style="font-size:1.1rem;">${r.flag}</td>
          <td style="color:var(--secondary);font-family:'Orbitron',sans-serif;font-size:0.8rem;">${r.level}</td>
          <td style="color:var(--primary);">${r.w}</td>
          <td style="color:var(--red);">${r.l}</td>
          <td style="font-family:'Orbitron',sans-serif;font-weight:700;">${r.pts.toLocaleString()}</td>
        </tr>`;
      }).join('');
    }

    function generateRankings() {
      const pRow = getPlayerRow();
      let global = [...AI_PLAYERS];
      if (pRow) {
        const idx = global.findIndex(r => r.pts < pRow.pts);
        if (idx === -1) global.push(pRow); else global.splice(idx, 0, pRow);
      }
      buildRankTable('rank-body-global', global);

      const pNat    = pRow ? pRow.nat : 'AR';
      let nacional  = global.filter(r => r.nat === pNat);
      if (nacional.length === 0) nacional = global.slice(0,5);
      buildRankTable('rank-body-nacional', nacional);

      const byLevel = [...global].sort((a,b) => b.level - a.level);
      buildRankTable('rank-body-nivel', byLevel);
    }

    /* ═══ TOURNAMENT ═══ */
    const LEAGUE_TEAMS = [
      'Las Panteras','Los Toros','Team Solera','Madrid Warriors',
      'Buenos Aires FC','Barcelona Padel','Rio Stars',
      'Mexico City Champs','London Elite','Paris Masters'
    ];

    function buildTournament() { buildLeague(); buildBracket(); buildCareer(); }

    function buildLeague() {
      const p    = loadPlayer();
      const pName = p ? `⭐ ${p.name}'s Team` : '⭐ Tu Equipo';
      const teams = [pName, ...LEAGUE_TEAMS.slice(0,9)];
      const standing = teams.map((name, i) => {
        if (i === 0) return { name, pj:0, v:0, d:0, pts:0, isPlayer:true };
        const v = Math.floor(Math.random()*7), d = Math.floor(Math.random()*5);
        return { name, pj:v+d, v, d, pts:v*3 };
      }).sort((a,b) => a.isPlayer ? 1 : b.isPlayer ? -1 : b.pts - a.pts);

      const nonP = standing.filter(t => !t.isPlayer);
      const playerR = standing.find(t => t.isPlayer);
      nonP.push(playerR);
      const sorted = nonP.sort((a,b) => b.pts - a.pts);

      document.getElementById('league-body').innerHTML = sorted.map((t,i) => `
        <tr class="${t.isPlayer?'player-row':''}">
          <td style="font-family:'Orbitron',sans-serif;font-weight:700;">${i+1}</td>
          <td>${t.isPlayer?`<strong style="color:var(--primary);">${t.name}</strong>`:t.name}</td>
          <td>${t.pj}</td>
          <td style="color:var(--primary);">${t.v}</td>
          <td style="color:var(--red);">${t.d}</td>
          <td style="font-family:'Orbitron',sans-serif;font-weight:700;color:var(--secondary);">${t.pts}</td>
        </tr>`).join('');

      const opp = LEAGUE_TEAMS[Math.floor(Math.random()*LEAGUE_TEAMS.length)];
      document.getElementById('next-match-player').textContent = p ? `${p.name}'s Team` : 'Tu Equipo';
      document.getElementById('next-match-opp').textContent    = opp;
    }

    function buildBracket() {
      const p     = loadPlayer();
      const pName = p ? p.name.split(' ')[0] : 'Tú';
      const el    = document.getElementById('bracket-wrap');
      if (!el) return;
      const rounds = [
        { title:'CUARTOS DE FINAL', matches:[[pName,'Las Panteras'],['Madrid Warriors','Los Toros'],['Buenos Aires FC','Rio Stars'],['London Elite','Paris Masters']], qf:true },
        { title:'SEMIFINAL',        matches:[[pName,'Madrid Warriors'],['Buenos Aires FC','London Elite']] },
        { title:'FINAL',            matches:[[pName,'Buenos Aires FC']] },
        { title:'🏆 CAMPEÓN',       matches:[[pName]], champ:true }
      ];
      el.innerHTML = rounds.map(r => `
        <div class="bracket-round">
          <div class="bracket-round-title">${r.title}</div>
          ${r.matches.map(m => r.champ
            ? `<div class="bracket-match" style="border-color:rgba(255,215,0,0.5);background:rgba(255,215,0,0.06);"><div class="bracket-team winner" style="color:var(--secondary);">🏆 ${m[0]}</div></div>`
            : `<div class="bracket-match">${m.map((t,i)=>{
                const ip=t===pName, iw=i===0;
                const c=ip?'player-team':iw?'winner':'';
                return `<div class="bracket-team ${c}">${ip?'⭐ ':''}${t}</div>`;
              }).join('<div class="bracket-divider"></div>')}</div>`
          ).join('')}
        </div>`).join('');
    }

    function buildCareer() {
      const s = loadStats(); const lvl = s.level||1;
      const stages = [
        {name:'Rookie',   icon:'🌱', desc:'Nivel 1–9 · Aprende lo básico',         min:1,  max:9  },
        {name:'Pro',      icon:'⚡', desc:'Nivel 10–29 · Torneo regional',          min:10, max:29 },
        {name:'Elite',    icon:'💎', desc:'Nivel 30–59 · Circuito nacional',        min:30, max:59 },
        {name:'Champion', icon:'🏆', desc:'Nivel 60–89 · Circuito internacional',   min:60, max:89 },
        {name:'Legend',   icon:'👑', desc:'Nivel 90+ · Campeón del mundo',          min:90, max:999}
      ];
      document.getElementById('career-path').innerHTML = stages.map(s => {
        const done=lvl>s.max, cur=lvl>=s.min&&lvl<=s.max;
        return `<div class="career-step ${done?'done':cur?'current':''}">
          <div class="career-badge ${done?'done':cur?'current':''}">${s.icon}</div>
          <div class="career-info">
            <div class="career-name" style="${cur?'color:var(--primary);':''}">${s.name}${cur?' ← Actual':''}${done?' ✓':''}</div>
            <div class="career-desc">${s.desc}</div>
          </div>
        </div>`;
      }).join('');
    }

    /* ═══ SETTINGS ═══ */
    function loadSettings() {
      try {
        const s = JSON.parse(localStorage.getItem(SK.SETTINGS)) || {};
        if (s.volGeneral !== undefined) { document.getElementById('vol-general').value = s.volGeneral; document.getElementById('vol-general-val').textContent = s.volGeneral; }
        if (s.sfx       !== undefined) document.getElementById('toggle-sfx').checked               = s.sfx;
        if (s.crowd     !== undefined) document.getElementById('toggle-crowd').checked             = s.crowd;
        if (s.music     !== undefined) document.getElementById('toggle-music').checked             = s.music;
        if (s.shadows   !== undefined) document.getElementById('toggle-shadows').checked           = s.shadows;
        if (s.particles !== undefined) document.getElementById('toggle-particles-setting').checked = s.particles;
        if (s.lang) { document.getElementById('lang-es').classList.toggle('active',s.lang==='es'); document.getElementById('lang-en').classList.toggle('active',s.lang==='en'); }
      } catch {}
    }
    function saveSetting(key, val) {
      try { const s=JSON.parse(localStorage.getItem(SK.SETTINGS))||{}; s[key]=val; localStorage.setItem(SK.SETTINGS,JSON.stringify(s)); } catch {}
    }
    function setQuality(q, el) {
      document.querySelectorAll('.quality-btn').forEach(b=>b.classList.remove('active'));
      el.classList.add('active');
      saveSetting('quality',q);
      showToast(`Calidad: ${q==='low'?'Baja':q==='medium'?'Media':'Alta'}`, 'info');
    }
    function setLang(lang, el) {
      document.querySelectorAll('.lang-btn').forEach(b=>b.classList.remove('active'));
      el.classList.add('active');
      saveSetting('lang',lang);
      showToast(lang==='es'?'¡Idioma: Español!':'Language: English!','success');
    }
    function resetData() {
      if (confirm('¿Seguro que deseas borrar todos los datos? Esta acción no se puede deshacer.')) {
        Object.values(SK).forEach(k=>localStorage.removeItem(k));
        showToast('Datos borrados','warning');
        updateMainGreeting(null);
        setTimeout(()=>showScreen('screen-main'),800);
      }
    }

    /* ═══ INIT ═══ */
    window.addEventListener('load', () => {
      spawnParticles();
      updateMainGreeting(loadPlayer());
      generateRankings();
      loadSettings();
      buildTournament();
    });
  </script>
</body>
</html>
