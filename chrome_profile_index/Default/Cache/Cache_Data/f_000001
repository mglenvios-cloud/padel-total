<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Padel Champions Online</title>
  <meta name="description" content="El simulador de pádel más realista. Juega partidas 2v2 con IA avanzada, torneos y ranking mundial.">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Inter:wght@300;400;600&display=swap');

    /* ─── RESET & BASE ─────────────────────────────── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --bg:        #0a0a1a;
      --primary:   #00C853;
      --primary-d: #00963d;
      --secondary: #FFD700;
      --surface:   rgba(255,255,255,0.06);
      --border:    rgba(0,200,83,0.3);
      --text:      #f0f0f0;
      --muted:     #888;
      --blue:      #2196F3;
      --red:       #f44336;
    }
    html, body {
      height: 100%;
      font-family: 'Inter', sans-serif;
      background: var(--bg);
      color: var(--text);
      overflow: hidden;
    }

    /* ─── ANIMATED BACKGROUND ────────────────────── */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background:
        radial-gradient(ellipse 80% 60% at 20% 30%, rgba(0,200,83,0.07) 0%, transparent 60%),
        radial-gradient(ellipse 60% 80% at 80% 70%, rgba(255,215,0,0.05) 0%, transparent 55%),
        radial-gradient(ellipse 50% 50% at 50% 50%, rgba(33,150,243,0.04) 0%, transparent 70%);
      animation: bgShift 30s ease-in-out infinite alternate;
      z-index: 0;
      pointer-events: none;
    }
    body::after {
      content: '';
      position: fixed;
      inset: 0;
      background-image:
        linear-gradient(rgba(0,200,83,0.04) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0,200,83,0.04) 1px, transparent 1px);
      background-size: 60px 60px;
      animation: gridPulse 8s ease-in-out infinite;
      z-index: 0;
      pointer-events: none;
    }
    @keyframes bgShift {
      0%   { opacity: 1; transform: scale(1) translate(0,0); }
      33%  { transform: scale(1.05) translate(2%, 1%); }
      66%  { transform: scale(0.98) translate(-1%, 2%); }
      100% { opacity: 1; transform: scale(1.03) translate(1%, -1%); }
    }
    @keyframes gridPulse {
      0%, 100% { opacity: 0.7; }
      50%       { opacity: 1; }
    }

    /* ─── PARTICLES ────────────────────────────────── */
    #particles {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 1;
      overflow: hidden;
    }
    .particle {
      position: absolute;
      bottom: -20px;
      border-radius: 50%;
      background: radial-gradient(circle at 35% 35%, #00C853, #007a32);
      box-shadow: 0 0 8px rgba(0,200,83,0.6);
      animation: floatUp linear infinite;
      opacity: 0;
    }
    @keyframes floatUp {
      0%   { transform: translateY(0) rotate(0deg); opacity: 0; }
      10%  { opacity: 0.7; }
      90%  { opacity: 0.3; }
      100% { transform: translateY(-110vh) rotate(720deg); opacity: 0; }
    }

    /* ─── TOAST ─────────────────────────────────────── */
    #toast-container {
      position: fixed;
      top: 20px;
      right: 20px;
      z-index: 9999;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .toast {
      padding: 14px 22px;
      border-radius: 12px;
      font-family: 'Inter', sans-serif;
      font-weight: 600;
      font-size: 0.9rem;
      opacity: 0;
      transform: translateX(120px);
      transition: all 0.4s cubic-bezier(0.34,1.56,0.64,1);
      backdrop-filter: blur(12px);
      max-width: 320px;
    }
    .toast.show { opacity: 1; transform: translateX(0); }
    .toast-success { background: rgba(0,200,83,0.2); border: 1px solid rgba(0,200,83,0.5); color: #00C853; }
    .toast-warning { background: rgba(255,215,0,0.15); border: 1px solid rgba(255,215,0,0.5); color: #FFD700; }
    .toast-info    { background: rgba(33,150,243,0.15); border: 1px solid rgba(33,150,243,0.5); color: #64B5F6; }
    .toast-error   { background: rgba(244,67,54,0.15); border: 1px solid rgba(244,67,54,0.5); color: #ef9a9a; }

    /* ─── SCREENS ────────────────────────────────────── */
    .screen {
      position: fixed;
      inset: 0;
      overflow-y: auto;
      overflow-x: hidden;
      z-index: 10;
      opacity: 0;
      transform: translateY(24px);
      pointer-events: none;
      transition: opacity 0.35s ease, transform 0.35s ease;
      padding: 24px 20px 40px;
    }
    .screen.active {
      opacity: 1;
      transform: translateY(0);
      pointer-events: all;
    }

    /* ─── GLASS CARD ──────────────────────────────────── */
    .card {
      background: var(--surface);
      border: 1px solid rgba(0,200,83,0.2);
      border-radius: 16px;
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      transition: all 0.3s ease;
      padding: 20px;
    }
    .card:hover {
      border-color: rgba(0,200,83,0.6);
      transform: translateY(-3px);
      box-shadow: 0 8px 32px rgba(0,200,83,0.2);
    }

    /* ─── BUTTONS ─────────────────────────────────────── */
    .btn-primary {
      background: linear-gradient(135deg, var(--primary), var(--primary-d));
      color: #fff;
      font-family: 'Orbitron', sans-serif;
      font-weight: 700;
      letter-spacing: 0.1em;
      border: none;
      border-radius: 12px;
      padding: 16px 32px;
      cursor: pointer;
      transition: all 0.3s;
      text-transform: uppercase;
      box-shadow: 0 4px 20px rgba(0,200,83,0.3);
      font-size: 0.9rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      width: 100%;
    }
    .btn-primary:hover { transform: translateY(-3px); box-shadow: 0 8px 30px rgba(0,200,83,0.5); }
    .btn-primary:active { transform: translateY(-1px); }
    .btn-secondary {
      background: var(--surface);
      color: var(--text);
      font-family: 'Orbitron', sans-serif;
      font-weight: 700;
      letter-spacing: 0.08em;
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 14px 28px;
      cursor: pointer;
      transition: all 0.3s;
      text-transform: uppercase;
      font-size: 0.85rem;
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      backdrop-filter: blur(8px);
    }
    .btn-secondary:hover { border-color: var(--primary); color: var(--primary); transform: translateY(-2px); box-shadow: 0 6px 20px rgba(0,200,83,0.2); }
    .btn-back {
      background: rgba(255,255,255,0.06);
      border: 1px solid rgba(255,255,255,0.15);
      border-radius: 10px;
      color: var(--muted);
      font-family: 'Inter', sans-serif;
      font-size: 0.85rem;
      padding: 8px 16px;
      cursor: pointer;
      transition: all 0.2s;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
    .btn-back:hover { color: var(--text); border-color: rgba(255,255,255,0.3); }

    /* ─── FORMS ───────────────────────────────────────── */
    .form-group { margin-bottom: 16px; }
    .form-group label { display: block; font-size: 0.78rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 6px; }
    input[type=text], input[type=number], select {
      background: rgba(255,255,255,0.08);
      border: 1px solid rgba(0,200,83,0.3);
      border-radius: 10px;
      color: var(--text);
      padding: 12px 16px;
      font-family: 'Inter', sans-serif;
      font-size: 0.9rem;
      width: 100%;
      outline: none;
      transition: border-color 0.2s, box-shadow 0.2s;
      -webkit-appearance: none;
    }
    input:focus, select:focus { border-color: var(--primary); box-shadow: 0 0 0 2px rgba(0,200,83,0.2); }
    select option { background: #0f1a2e; color: var(--text); }

    /* ─── RANGE SLIDER ────────────────────────────────── */
    input[type=range] {
      -webkit-appearance: none;
      appearance: none;
      height: 6px;
      border-radius: 3px;
      background: rgba(255,255,255,0.1);
      border: none;
      outline: none;
      padding: 0;
      cursor: pointer;
    }
    input[type=range]::-webkit-slider-thumb {
      -webkit-appearance: none;
      width: 20px; height: 20px;
      border-radius: 50%;
      background: var(--primary);
      box-shadow: 0 0 8px rgba(0,200,83,0.5);
      cursor: pointer;
    }

    /* ─── TOGGLE SWITCH ───────────────────────────────── */
    .toggle-wrap { display: flex; align-items: center; justify-content: space-between; padding: 10px 0; }
    .toggle-wrap span { font-size: 0.9rem; color: var(--text); }
    .toggle { position: relative; width: 50px; height: 26px; }
    .toggle input { opacity: 0; width: 0; height: 0; }
    .toggle-slider {
      position: absolute; inset: 0;
      background: rgba(255,255,255,0.1);
      border-radius: 13px;
      cursor: pointer;
      transition: 0.3s;
      border: 1px solid rgba(255,255,255,0.1);
    }
    .toggle-slider::before {
      content: '';
      position: absolute;
      width: 20px; height: 20px;
      left: 3px; top: 2px;
      background: var(--muted);
      border-radius: 50%;
      transition: 0.3s;
    }
    .toggle input:checked + .toggle-slider { background: rgba(0,200,83,0.3); border-color: var(--primary); }
    .toggle input:checked + .toggle-slider::before { transform: translateX(24px); background: var(--primary); }

    /* ─── SCREEN HEADER ───────────────────────────────── */
    .screen-header {
      display: flex;
      align-items: center;
      gap: 16px;
      margin-bottom: 28px;
      padding-top: 8px;
    }
    .screen-title {
      font-family: 'Orbitron', sans-serif;
      font-size: 1.4rem;
      font-weight: 900;
      color: var(--text);
      letter-spacing: 0.15em;
      text-transform: uppercase;
    }

    /* ─── XP BAR ─────────────────────────────────────── */
    .xp-bar-wrap { background: rgba(255,255,255,0.1); border-radius: 8px; height: 8px; overflow: hidden; margin: 8px 0; }
    .xp-bar-fill {
      height: 100%;
      background: linear-gradient(90deg, var(--primary), var(--secondary));
      border-radius: 8px;
      transition: width 1s cubic-bezier(0.34,1.56,0.64,1);
      animation: xpGlow 2s ease-in-out infinite;
    }
    @keyframes xpGlow {
      0%, 100% { box-shadow: 0 0 4px rgba(0,200,83,0.4); }
      50%       { box-shadow: 0 0 12px rgba(0,200,83,0.8); }
    }

    /* ─── TABS ────────────────────────────────────────── */
    .tabs { display: flex; gap: 6px; margin-bottom: 20px; flex-wrap: wrap; }
    .tab-btn {
      padding: 8px 18px;
      border-radius: 8px;
      border: 1px solid rgba(255,255,255,0.1);
      background: rgba(255,255,255,0.05);
      color: var(--muted);
      font-family: 'Inter', sans-serif;
      font-weight: 600;
      font-size: 0.85rem;
      cursor: pointer;
      transition: all 0.2s;
      white-space: nowrap;
    }
    .tab-btn.active, .tab-btn:hover { background: rgba(0,200,83,0.15); border-color: var(--primary); color: var(--primary); }
    .tab-panel { display: none; }
    .tab-panel.active { display: block; }

    /* ─── TABLE ───────────────────────────────────────── */
    .data-table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
    .data-table th {
      padding: 10px 12px;
      text-align: left;
      font-family: 'Orbitron', sans-serif;
      font-size: 0.7rem;
      font-weight: 700;
      color: var(--muted);
      letter-spacing: 0.1em;
      text-transform: uppercase;
      border-bottom: 1px solid rgba(255,255,255,0.1);
    }
    .data-table td { padding: 10px 12px; border-bottom: 1px solid rgba(255,255,255,0.04); vertical-align: middle; }
    .data-table tr:hover td { background: rgba(255,255,255,0.03); }
    .data-table tr.player-row td { background: rgba(0,200,83,0.06); box-shadow: inset 0 0 0 1px rgba(0,200,83,0.2); }

    /* ─── SEPARATOR ───────────────────────────────────── */
    .separator {
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(0,200,83,0.4), transparent);
      margin: 20px 0;
      animation: sepPulse 3s ease-in-out infinite;
    }
    @keyframes sepPulse { 0%,100% { opacity:0.5; } 50% { opacity:1; } }

    /* ════════════════════════════════════════════════════
       SCREEN 1 – MAIN MENU
    ════════════════════════════════════════════════════ */
    #screen-main {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      padding: 20px;
      text-align: center;
    }
    .version-badge {
      position: fixed;
      top: 16px;
      right: 20px;
      font-size: 0.72rem;
      color: var(--muted);
      font-family: 'Orbitron', sans-serif;
      letter-spacing: 0.1em;
      background: rgba(255,255,255,0.04);
      padding: 4px 10px;
      border-radius: 20px;
      border: 1px solid rgba(255,255,255,0.08);
    }
    .court-bg {
      position: fixed;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      pointer-events: none;
      z-index: 0;
      animation: courtZoom 20s ease-in-out infinite alternate;
      background: radial-gradient(circle, rgba(10,10,26,0.25) 0%, rgba(10,10,26,0.93) 85%), url('padel_court_hero.png') no-repeat center center;
      background-size: cover;
      opacity: 0.25;
    }
    @keyframes courtZoom { 0% { transform: scale(1); } 100% { transform: scale(1.08); } }
    .logo-area { position: relative; z-index: 2; margin-bottom: 32px; }
    .logo-emoji { font-size: 3.5rem; display: block; margin-bottom: 8px; animation: bounceIcon 3s ease-in-out infinite; }
    @keyframes bounceIcon { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }
    .logo-title {
      font-family: 'Orbitron', sans-serif;
      font-weight: 900;
      font-size: clamp(2rem, 6vw, 3.5rem);
      background: linear-gradient(135deg, var(--primary), var(--secondary));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      letter-spacing: 0.08em;
      line-height: 1;
      animation: logoGlow 2s ease-in-out infinite;
      text-transform: uppercase;
    }
    @keyframes logoGlow {
      0%,100% { filter: drop-shadow(0 0 8px rgba(0,200,83,0.4)); }
      50%      { filter: drop-shadow(0 0 20px rgba(0,200,83,0.8)) drop-shadow(0 0 40px rgba(255,215,0,0.3)); }
    }
    .logo-online {
      font-family: 'Orbitron', sans-serif;
      font-weight: 700;
      font-size: clamp(1rem, 3vw, 1.5rem);
      color: var(--secondary);
      letter-spacing: 0.8em;
      text-indent: 0.8em;
      margin-top: 4px;
    }
    .logo-tagline {
      font-size: 0.9rem;
      color: var(--muted);
      margin-top: 10px;
      font-weight: 300;
      letter-spacing: 0.03em;
    }
    .main-nav {
      position: relative;
      z-index: 2;
      width: 100%;
      max-width: 340px;
      display: flex;
      flex-direction: column;
      gap: 10px;
      margin: 0 auto;
    }
    .main-nav .btn-secondary { height: 60px; font-size: 0.85rem; }
    .greeting-bar {
      position: relative;
      z-index: 2;
      margin-top: 28px;
      font-size: 0.85rem;
      color: var(--muted);
    }
    .greeting-bar .player-name-highlight { color: var(--primary); font-weight: 600; }
    .copyright {
      position: fixed;
      bottom: 14px;
      left: 50%;
      transform: translateX(-50%);
      font-size: 0.68rem;
      color: rgba(136,136,136,0.5);
      white-space: nowrap;
      z-index: 2;
    }

    /* ════════════════════════════════════════════════════
       SCREEN 2 – GAME MODES
    ════════════════════════════════════════════════════ */
    .modes-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
      margin-bottom: 24px;
    }
    .mode-card {
      cursor: pointer;
      text-align: center;
      padding: 28px 16px;
      border-radius: 16px;
      background: var(--surface);
      border: 2px solid rgba(0,200,83,0.15);
      backdrop-filter: blur(10px);
      transition: all 0.3s ease;
      position: relative;
      overflow: hidden;
    }
    .mode-card::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(135deg, transparent, rgba(0,200,83,0.04));
      opacity: 0;
      transition: opacity 0.3s;
    }
    .mode-card:hover::before, .mode-card.selected::before { opacity: 1; }
    .mode-card:hover { transform: translateY(-4px); box-shadow: 0 12px 40px rgba(0,200,83,0.2); border-color: rgba(0,200,83,0.5); }
    .mode-card.selected { border-color: var(--primary); box-shadow: 0 0 0 1px var(--primary), 0 12px 40px rgba(0,200,83,0.3); }
    .mode-icon { font-size: 2.5rem; display: block; margin-bottom: 10px; }
    .mode-name { font-family: 'Orbitron', sans-serif; font-weight: 700; font-size: 0.85rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text); margin-bottom: 6px; }
    .mode-desc { font-size: 0.75rem; color: var(--muted); line-height: 1.4; }
    .options-panel { background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 20px; margin-bottom: 20px; backdrop-filter: blur(10px); }
    .options-title { font-family: 'Orbitron', sans-serif; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.15em; text-transform: uppercase; color: var(--muted); margin-bottom: 14px; }
    .stars-row { display: flex; gap: 8px; margin-bottom: 4px; }
    .star { font-size: 1.5rem; cursor: pointer; transition: transform 0.15s, filter 0.15s; filter: grayscale(1) opacity(0.4); }
    .star.active { filter: grayscale(0) drop-shadow(0 0 6px rgba(255,215,0,0.7)); transform: scale(1.15); }
    .court-toggle { display: flex; gap: 8px; margin-top: 12px; }
    .court-btn {
      flex: 1; padding: 10px; border-radius: 10px; border: 1px solid rgba(255,255,255,0.1);
      background: rgba(255,255,255,0.04); color: var(--muted); cursor: pointer; transition: all 0.2s;
      font-size: 0.85rem; font-family: 'Inter', sans-serif; font-weight: 600;
    }
    .court-btn.active { background: rgba(0,200,83,0.15); border-color: var(--primary); color: var(--primary); }
    .btn-play-now {
      background: linear-gradient(135deg, var(--primary), var(--primary-d));
      color: #fff;
      font-family: 'Orbitron', sans-serif;
      font-weight: 900;
      letter-spacing: 0.15em;
      border: none;
      border-radius: 14px;
      height: 65px;
      font-size: 1rem;
      cursor: pointer;
      width: 100%;
      text-transform: uppercase;
      transition: all 0.3s;
      box-shadow: 0 4px 20px rgba(0,200,83,0.3);
      position: relative;
      overflow: hidden;
    }
    .btn-play-now::after {
      content: '';
      position: absolute;
      inset: -2px;
      border-radius: 16px;
      background: transparent;
      border: 2px solid var(--primary);
      animation: playPulse 1.5s ease-in-out infinite;
      opacity: 0;
    }
    .btn-play-now.ready::after { opacity: 1; }
    @keyframes playPulse { 0%,100% { transform: scale(1); opacity:0.8; } 50% { transform: scale(1.04); opacity: 0; } }
    .btn-play-now:hover { transform: translateY(-3px); box-shadow: 0 10px 40px rgba(0,200,83,0.6); }

    /* ════════════════════════════════════════════════════
       SCREEN 3 – MY PLAYER
    ════════════════════════════════════════════════════ */
    .player-layout { display: flex; gap: 20px; align-items: flex-start; }
    .player-left { width: 200px; flex-shrink: 0; }
    .player-right { flex: 1; min-width: 0; }
    .avatar-circle {
      width: 120px; height: 120px;
      border-radius: 50%;
      background: linear-gradient(135deg, rgba(0,200,83,0.3), rgba(255,215,0,0.2));
      border: 3px solid var(--primary);
      display: flex; align-items: center; justify-content: center;
      font-family: 'Orbitron', sans-serif;
      font-size: 2.2rem;
      font-weight: 900;
      color: var(--primary);
      margin: 0 auto 12px;
      box-shadow: 0 0 30px rgba(0,200,83,0.3);
      transition: box-shadow 0.3s;
    }
    .avatar-circle:hover { box-shadow: 0 0 50px rgba(0,200,83,0.5); }
    .avatar-name { text-align: center; font-family: 'Orbitron', sans-serif; font-weight: 700; font-size: 0.9rem; margin-bottom: 4px; }
    .level-badge { display: inline-block; background: linear-gradient(135deg, var(--primary), var(--secondary)); color: #000; font-family: 'Orbitron', sans-serif; font-weight: 900; font-size: 0.7rem; padding: 3px 10px; border-radius: 20px; margin: 0 auto 8px; }
    .xp-label { font-size: 0.7rem; color: var(--muted); text-align: center; margin-bottom: 2px; }
    .stat-cards { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 6px; margin-top: 12px; }
    .stat-card { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.08); border-radius: 10px; padding: 8px 4px; text-align: center; }
    .stat-val { font-family: 'Orbitron', sans-serif; font-weight: 700; font-size: 1rem; color: var(--primary); }
    .stat-lbl { font-size: 0.62rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.05em; }

    .hand-toggle { display: flex; gap: 8px; }
    .hand-btn {
      flex: 1; padding: 10px; border-radius: 10px; border: 1px solid rgba(255,255,255,0.1);
      background: rgba(255,255,255,0.04); color: var(--muted); cursor: pointer; transition: all 0.2s;
      font-size: 0.85rem; font-weight: 600; font-family: 'Inter', sans-serif;
    }
    .hand-btn.active { background: rgba(0,200,83,0.15); border-color: var(--primary); color: var(--primary); }

    .section-title {
      font-family: 'Orbitron', sans-serif;
      font-weight: 700;
      font-size: 0.8rem;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--primary);
      margin-bottom: 12px;
    }
    .racket-grid { display: flex; gap: 10px; flex-wrap: wrap; }
    .racket-card {
      flex: 1; min-width: 100px;
      padding: 14px 10px;
      border-radius: 12px;
      background: var(--surface);
      border: 2px solid rgba(255,255,255,0.08);
      cursor: pointer;
      transition: all 0.25s;
      text-align: center;
    }
    .racket-card:hover { border-color: rgba(0,200,83,0.4); transform: translateY(-2px); }
    .racket-card.selected { border-color: var(--primary); box-shadow: 0 0 20px rgba(0,200,83,0.3); background: rgba(0,200,83,0.08); }
    .racket-icon { font-size: 1.8rem; display: block; margin-bottom: 6px; }
    .racket-name { font-family: 'Orbitron', sans-serif; font-size: 0.62rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text); margin-bottom: 3px; }
    .racket-stat { font-size: 0.65rem; color: var(--muted); }

    .outfit-swatches { display: flex; gap: 10px; flex-wrap: wrap; }
    .swatch {
      width: 40px; height: 40px; border-radius: 50%; cursor: pointer;
      border: 3px solid transparent; transition: all 0.2s;
      box-shadow: 0 2px 8px rgba(0,0,0,0.3);
    }
    .swatch:hover { transform: scale(1.15); }
    .swatch.selected { border-color: #fff; box-shadow: 0 0 12px rgba(255,255,255,0.5); transform: scale(1.15); }

    /* ════════════════════════════════════════════════════
       SCREEN 4 – TOURNAMENT
    ════════════════════════════════════════════════════ */
    .league-table-wrap { background: var(--surface); border: 1px solid var(--border); border-radius: 16px; overflow: hidden; }
    .next-match-card { background: rgba(0,200,83,0.07); border: 1px solid rgba(0,200,83,0.25); border-radius: 16px; padding: 20px; margin-bottom: 16px; }
    .next-match-label { font-family: 'Orbitron', sans-serif; font-size: 0.7rem; font-weight: 700; letter-spacing: 0.15em; text-transform: uppercase; color: var(--primary); margin-bottom: 10px; }
    .match-vs { display: flex; align-items: center; justify-content: center; gap: 16px; }
    .match-team { font-family: 'Orbitron', sans-serif; font-weight: 700; font-size: 0.9rem; }
    .match-vs-text { font-size: 0.75rem; color: var(--muted); font-weight: 300; }

    /* BRACKET */
    .bracket-wrap { display: flex; gap: 0; overflow-x: auto; padding-bottom: 10px; }
    .bracket-round { display: flex; flex-direction: column; justify-content: space-around; min-width: 160px; padding: 0 10px; position: relative; }
    .bracket-round-title { font-family: 'Orbitron', sans-serif; font-size: 0.65rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); text-align: center; margin-bottom: 12px; }
    .bracket-match { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 10px; padding: 8px 10px; margin: 6px 0; }
    .bracket-team { padding: 4px 0; font-size: 0.78rem; color: var(--text); display: flex; align-items: center; gap: 6px; }
    .bracket-team.winner { color: var(--primary); font-weight: 600; }
    .bracket-team.player-team { color: var(--secondary); font-weight: 700; }
    .bracket-divider { height: 1px; background: rgba(255,255,255,0.08); margin: 3px 0; }

    /* CAREER */
    .career-path { display: flex; flex-direction: column; gap: 12px; }
    .career-step { display: flex; align-items: center; gap: 14px; padding: 16px; border-radius: 12px; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.07); transition: all 0.2s; }
    .career-step.current { background: rgba(0,200,83,0.08); border-color: rgba(0,200,83,0.3); }
    .career-step.done { border-color: rgba(0,200,83,0.2); }
    .career-badge { width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.3rem; background: rgba(255,255,255,0.06); flex-shrink: 0; }
    .career-badge.done { background: rgba(0,200,83,0.2); }
    .career-badge.current { background: rgba(0,200,83,0.3); box-shadow: 0 0 12px rgba(0,200,83,0.4); }
    .career-info { flex: 1; }
    .career-name { font-family: 'Orbitron', sans-serif; font-weight: 700; font-size: 0.85rem; margin-bottom: 3px; }
    .career-desc { font-size: 0.75rem; color: var(--muted); }

    /* MUNDIAL */
    .mundial-overlay { position: relative; }
    .lock-overlay { position: absolute; inset: 0; background: rgba(10,10,26,0.85); border-radius: 16px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; z-index: 5; }
    .lock-icon { font-size: 2.5rem; }
    .lock-msg { font-family: 'Orbitron', sans-serif; font-weight: 700; font-size: 0.9rem; color: var(--secondary); text-align: center; }
    .lock-sub { font-size: 0.8rem; color: var(--muted); text-align: center; }

    /* ════════════════════════════════════════════════════
       SCREEN 5 – RANKINGS
    ════════════════════════════════════════════════════ */
    .rank-medal { font-size: 1.1rem; }
    .rank-num { font-family: 'Orbitron', sans-serif; font-weight: 700; font-size: 0.9rem; }
    .rank-gold   td { color: #FFD700; }
    .rank-silver td { color: #C0C0C0; }
    .rank-bronze td { color: #CD7F32; }

    /* ════════════════════════════════════════════════════
       SCREEN 6 – SETTINGS
    ════════════════════════════════════════════════════ */
    .settings-section { margin-bottom: 20px; }
    .settings-section-title { font-family: 'Orbitron', sans-serif; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.15em; text-transform: uppercase; color: var(--primary); margin-bottom: 10px; padding-bottom: 6px; border-bottom: 1px solid rgba(0,200,83,0.2); }
    .settings-panel { background: var(--surface); border: 1px solid rgba(255,255,255,0.08); border-radius: 16px; padding: 16px 20px; }
    .quality-btns { display: flex; gap: 8px; }
    .quality-btn {
      flex: 1; padding: 8px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.1);
      background: rgba(255,255,255,0.04); color: var(--muted); cursor: pointer; transition: all 0.2s;
      font-size: 0.8rem; font-weight: 600;
    }
    .quality-btn.active { background: rgba(0,200,83,0.15); border-color: var(--primary); color: var(--primary); }
    .keybinds-table { width: 100%; font-size: 0.82rem; }
    .keybinds-table tr { border-bottom: 1px solid rgba(255,255,255,0.05); }
    .keybinds-table td { padding: 8px 6px; }
    .keybinds-table td:first-child { color: var(--muted); }
    .keybinds-table td:last-child { text-align: right; }
    .key-badge { display: inline-block; background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); border-radius: 6px; padding: 2px 8px; font-family: 'Orbitron', sans-serif; font-size: 0.65rem; font-weight: 700; color: var(--text); }
    .lang-btns { display: flex; gap: 10px; }
    .lang-btn {
      flex: 1; padding: 10px; border-radius: 10px; border: 1px solid rgba(255,255,255,0.1);
      background: rgba(255,255,255,0.04); color: var(--text); cursor: pointer; transition: all 0.2s;
      font-size: 1rem; text-align: center;
    }
    .lang-btn.active { border-color: var(--primary); background: rgba(0,200,83,0.1); }
    .slider-row { display: flex; align-items: center; gap: 12px; padding: 8px 0; }
    .slider-row span:first-child { flex: 0 0 130px; font-size: 0.88rem; color: var(--text); }
    .slider-row input[type=range] { flex: 1; }
    .slider-row .slider-val { flex: 0 0 34px; text-align: right; font-family: 'Orbitron', sans-serif; font-size: 0.75rem; color: var(--primary); }

    /* ─── RESPONSIVE ─────────────────────────────────── */
    @media (max-width: 640px) {
      .modes-grid { grid-template-columns: 1fr; }
      .player-layout { flex-direction: column; }
      .player-left { width: 100%; }
      .racket-grid { gap: 6px; }
      .racket-card { min-width: 80px; }
      .bracket-wrap { gap: 0; }
      .bracket-round { min-width: 130px; }
      .screen-title { font-size: 1.1rem; }
    }
    @media (max-width: 400px) {
      .logo-title { font-size: 1.6rem; }
      .logo-online { letter-spacing: 0.3em; }
    }
  </style>
</head>
<body>

  <!-- PARTICLES -->
  <div id="particles"></div>

  <!-- TOASTS -->
  <div id="toast-container"></div>

  <!-- ═══ SCREEN 1 – MAIN MENU ═══ -->
  <div id="screen-main" class="screen active">
    <span class="version-badge">v1.0</span>

    <div class="court-bg">
      <svg viewBox="0 0 800 450" width="90%" height="90%" xmlns="http://www.w3.org/2000/svg" style="opacity:0.05">
        <rect x="60" y="40" width="680" height="370" fill="none" stroke="white" stroke-width="3"/>
        <line x1="60" y1="225" x2="740" y2="225" stroke="white" stroke-width="3"/>
        <line x1="400" y1="40" x2="400" y2="410" stroke="white" stroke-width="1.5"/>
        <line x1="230" y1="40" x2="230" y2="410" stroke="white" stroke-width="1.5"/>
        <line x1="570" y1="40" x2="570" y2="410" stroke="white" stroke-width="1.5"/>
        <line x1="230" y1="225" x2="570" y2="225" stroke="white" stroke-width="1"/>
      </svg>
    </div>

    <div class="logo-area">
      <span class="logo-emoji">🎾</span>
      <div class="logo-title">PADEL CHAMPIONS</div>
      <div class="logo-online">ONLINE</div>
      <p class="logo-tagline">El simulador más realista de pádel 2vs2</p>
      <div class="separator" style="margin-top:20px;"></div>
    </div>

    <nav class="main-nav">
      <button class="btn-secondary" onclick="showScreen('screen-modes')">🎮 &nbsp;JUGAR</button>
      <button class="btn-secondary" onclick="showScreen('screen-player')">👤 &nbsp;MI JUGADOR</button>
      <button class="btn-secondary" onclick="showScreen('screen-tournament')">🏆 &nbsp;TORNEOS</button>
      <button class="btn-secondary" onclick="showScreen('screen-rankings')">📊 &nbsp;RANKING</button>
      <button class="btn-secondary" onclick="showScreen('screen-settings')">⚙️ &nbsp;AJUSTES</button>
    </nav>

    <div class="greeting-bar">
      <p id="player-greeting">Crea tu jugador para comenzar</p>
    </div>

    <div class="copyright">© 2026 Padel Champions Online · Todos los derechos reservados · v1.0.0</div>
  </div>

  <!-- ═══ SCREEN 2 – GAME MODES ═══ -->
  <div id="screen-modes" class="screen">
    <div style="max-width:700px;margin:0 auto;padding-top:10px;">
      <div class="screen-header">
        <button class="btn-back" onclick="goBack()">← Volver</button>
        <h2 class="screen-title">Seleccionar Modo</h2>
      </div>

      <div class="modes-grid">
        <div class="mode-card selected" id="mode-quick" onclick="selectMode('quick',this)">
          <span class="mode-icon">🎯</span>
          <div class="mode-name">Partida Rápida</div>
          <div class="mode-desc">2 vs 2 con IA avanzada</div>
        </div>
        <div class="mode-card" id="mode-ai" onclick="selectMode('ai',this)">
          <span class="mode-icon">🤖</span>
          <div class="mode-name">IA vs IA</div>
          <div class="mode-desc">Modo espectador, mira jugar a la IA</div>
        </div>
        <div class="mode-card" id="mode-training" onclick="selectMode('training',this)">
          <span class="mode-icon">🎓</span>
          <div class="mode-name">Entrenamiento</div>
          <div class="mode-desc">Practica tus golpes y mejora</div>
        </div>
        <div class="mode-card" id="mode-tournament" onclick="selectMode('tournament',this)">
          <span class="mode-icon">🏆</span>
          <div class="mode-name">Torneo</div>
          <div class="mode-desc">Competición oficial con ranking</div>
        </div>
      </div>

      <div class="options-panel">
        <div class="options-title">Dificultad</div>
        <div class="stars-row" id="stars-row">
          <span class="star active" onclick="setDifficulty(1)">★</span>
          <span class="star active" onclick="setDifficulty(2)">★</span>
          <span class="star active" onclick="setDifficulty(3)">★</span>
          <span class="star" onclick="setDifficulty(4)">★</span>
          <span class="star" onclick="setDifficulty(5)">★</span>
        </div>
        <div class="options-title" style="margin-top:16px;">Tipo de Cancha</div>
        <div class="court-toggle">
          <button class="court-btn active" id="court-indoor" onclick="setCourt('indoor')">🏟️ Indoor</button>
          <button class="court-btn" id="court-outdoor" onclick="setCourt('outdoor')">☀️ Outdoor</button>
        </div>
      </div>

      <button class="btn-play-now ready" id="btn-play-now" onclick="startGame(selectedMode)">⚡ JUGAR AHORA</button>
      <p id="modes-warning" style="text-align:center;color:var(--secondary);font-size:0.8rem;margin-top:10px;display:none;">⚠️ Crea tu jugador primero en "Mi Jugador"</p>
    </div>
  </div>

  <!-- ═══ SCREEN 3 – MY PLAYER ═══ -->
  <div id="screen-player" class="screen">
    <div style="max-width:900px;margin:0 auto;padding-top:10px;">
      <div class="screen-header">
        <button class="btn-back" onclick="goBack()">← Volver</button>
        <h2 class="screen-title">Mi Jugador</h2>
      </div>

      <div class="player-layout">
        <div class="player-left">
          <div class="card" style="text-align:center;padding:20px 14px;">
            <div class="avatar-circle" id="avatar-display">?</div>
            <div class="avatar-name" id="avatar-name">Nuevo Jugador</div>
            <div style="text-align:center;margin-bottom:4px;">
              <span class="level-badge" id="avatar-level">LVL 1</span>
            </div>
            <div class="xp-label" id="xp-label">0 / 1000 XP</div>
            <div class="xp-bar-wrap"><div class="xp-bar-fill" id="xp-bar" style="width:0%"></div></div>
            <div class="stat-cards" style="margin-top:14px;">
              <div class="stat-card"><div class="stat-val" id="stat-w">0</div><div class="stat-lbl">V</div></div>
              <div class="stat-card"><div class="stat-val" id="stat-l">0</div><div class="stat-lbl">D</div></div>
              <div class="stat-card"><div class="stat-val" id="stat-eff">0%</div><div class="stat-lbl">EFE</div></div>
            </div>
          </div>
        </div>

        <div class="player-right">
          <div class="card" style="margin-bottom:16px;">
            <div class="form-group">
              <label>Nombre</label>
              <input type="text" id="player-name" placeholder="Tu nombre" maxlength="30" oninput="updateAvatarPreview()">
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
              <div class="form-group">
                <label>Edad</label>
                <input type="number" id="player-age" min="16" max="45" placeholder="25">
              </div>
              <div class="form-group">
                <label>Mano</label>
                <div class="hand-toggle">
                  <button class="hand-btn active" data-hand="right" onclick="setHand('right',this)">Derecha</button>
                  <button class="hand-btn" data-hand="left" onclick="setHand('left',this)">Izquierda</button>
                </div>
              </div>
            </div>
            <div class="form-group">
              <label>Nacionalidad</label>
              <select id="player-nationality">
                <option value="AR">🇦🇷 Argentina</option>
                <option value="ES">🇪🇸 España</option>
                <option value="BR">🇧🇷 Brasil</option>
                <option value="MX">🇲🇽 México</option>
                <option value="UY">🇺🇾 Uruguay</option>
                <option value="CL">🇨🇱 Chile</option>
                <option value="PY">🇵🇾 Paraguay</option>
                <option value="PE">🇵🇪 Perú</option>
                <option value="CO">🇨🇴 Colombia</option>
                <option value="VE">🇻🇪 Venezuela</option>
                <option value="US">🇺🇸 USA</option>
                <option value="GB">🇬🇧 UK</option>
                <option value="FR">🇫🇷 Francia</option>
                <option value="IT">🇮🇹 Italia</option>
                <option value="DE">🇩🇪 Alemania</option>
                <option value="AU">🇦🇺 Australia</option>
                <option value="PT">🇵🇹 Portugal</option>
                <option value="NL">🇳🇱 Países Bajos</option>
                <option value="BE">🇧🇪 Bélgica</option>
                <option value="SE">🇸🇪 Suecia</option>
              </select>
            </div>
            <div class="form-group">
              <label>Estilo de Juego</label>
              <select id="player-style">
                <option value="aggressive">Agresivo</option>
                <option value="defensive">Defensivo</option>
                <option value="balanced" selected>Equilibrado</option>
                <option value="serve">Saque y Red</option>
              </select>
            </div>
          </div>

          <div class="card" style="margin-bottom:16px;">
            <div class="section-title">🏓 Paleta</div>
            <div class="racket-grid">
              <div class="racket-card selected" onclick="selectRacket(0,this)">
                <span class="racket-icon">🔥</span>
                <div class="racket-name">Power Pro</div>
                <div class="racket-stat">Potencia</div>
              </div>
              <div class="racket-card" onclick="selectRacket(1,this)">
                <span class="racket-icon">⚡</span>
                <div class="racket-name">Speed Ctrl</div>
                <div class="racket-stat">Velocidad</div>
              </div>
              <div class="racket-card" onclick="selectRacket(2,this)">
                <span class="racket-icon">💎</span>
                <div class="racket-name">Diamond</div>
                <div class="racket-stat">Precisión</div>
              </div>
              <div class="racket-card" onclick="selectRacket(3,this)">
                <span class="racket-icon">🏆</span>
                <div class="racket-name">Classic</div>
                <div class="racket-stat">Equilibrio</div>
              </div>
            </div>
          </div>

          <div class="card" style="margin-bottom:16px;">
            <div class="section-title">👕 Equipación</div>
            <div class="outfit-swatches" id="outfit-swatches">
              <div class="swatch selected" style="background:#2196F3;" onclick="selectOutfit(0,this)"></div>
              <div class="swatch" style="background:#f44336;" onclick="selectOutfit(1,this)"></div>
              <div class="swatch" style="background:#00C853;" onclick="selectOutfit(2,this)"></div>
              <div class="swatch" style="background:#9C27B0;" onclick="selectOutfit(3,this)"></div>
              <div class="swatch" style="background:#FF9800;" onclick="selectOutfit(4,this)"></div>
              <div class="swatch" style="background:#333;" onclick="selectOutfit(5,this)"></div>
            </div>
          </div>

          <button class="btn-primary" onclick="savePlayer()">💾 GUARDAR JUGADOR</button>
        </div>
      </div>
    </div>
  </div>

  <!-- ═══ SCREEN 4 – TOURNAMENT ═══ -->
  <div id="screen-tournament" class="screen">
    <div style="max-width:900px;margin:0 auto;padding-top:10px;">
      <div class="screen-header">
        <button class="btn-back" onclick="goBack()">← Volver</button>
        <h2 class="screen-title">Torneos</h2>
      </div>

      <div class="tabs">
        <button class="tab-btn active" onclick="switchTab('tourn','liga',this)">⚽ Liga</button>
        <button class="tab-btn" onclick="switchTab('tourn','copa',this)">🥊 Copa</button>
        <button class="tab-btn" onclick="switchTab('tourn','mundial',this)">🌍 Mundial</button>
        <button class="tab-btn" onclick="switchTab('tourn','carrera',this)">🚀 Carrera</button>
      </div>

      <div class="tab-panel active" id="tourn-liga">
        <div class="next-match-card">
          <div class="next-match-label">⚡ Próximo Partido</div>
          <div class="match-vs">
            <span class="match-team" id="next-match-player" style="color:var(--primary);">Tu Equipo</span>
            <span class="match-vs-text">VS</span>
            <span class="match-team" id="next-match-opp" style="color:var(--red);">Las Panteras</span>
          </div>
        </div>
        <div class="league-table-wrap" style="margin-bottom:16px;">
          <table class="data-table">
            <thead>
              <tr><th>Pos</th><th>Equipo</th><th>PJ</th><th>V</th><th>D</th><th>Pts</th></tr>
