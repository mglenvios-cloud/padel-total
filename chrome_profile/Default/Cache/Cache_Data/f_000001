function showServeOverlay(){document.getElementById('serve-overlay').style.display='block';}
function hideServeOverlay(){document.getElementById('serve-overlay').style.display='none';}

/* =====================================================
   AUDIO
===================================================== */
let audioCtx=null;
function initAudio(){if(audioCtx)return;try{audioCtx=new(window.AudioContext||window.webkitAudioContext)();}catch(e){}}
function playTone(freq,dur,type,vol){
  if(!audioCtx)return;
  try{
    audioCtx.resume();
    const o=audioCtx.createOscillator(),g=audioCtx.createGain();
    o.connect(g);g.connect(audioCtx.destination);
    o.type=type||'square';o.frequency.setValueAtTime(freq,audioCtx.currentTime);
    o.frequency.exponentialRampToValueAtTime(Math.max(1,freq*0.5),audioCtx.currentTime+dur);
    g.gain.setValueAtTime(vol||0.22,audioCtx.currentTime);
    g.gain.exponentialRampToValueAtTime(0.001,audioCtx.currentTime+dur);
    o.start();o.stop(audioCtx.currentTime+dur+0.02);
  }catch(e){}
}
function playBallHit(p){playTone(280+p*380,0.07,'square',0.22);}
function playBounce(){playTone(130,0.06,'sine',0.18);}
function playWallHit(){playTone(210,0.05,'square',0.14);}
function playPointWon(){if(!audioCtx)return;[523,659,784,1047].forEach((f,i)=>setTimeout(()=>playTone(f,0.14,'sine',0.26),i*130));}

/* =====================================================
   CAMERA
===================================================== */
function cycleCamera(){GS.cameraMode=(GS.cameraMode+1)%CAM_POSITIONS.length;}
function updateCamera(dt){
  const cp=CAM_POSITIONS[GS.cameraMode];
  camPos.lerp(cp.pos,dt*2.5);camLook.lerp(cp.look,dt*2.5);
  camera.position.copy(camPos);camera.lookAt(camLook);
}

/* =====================================================
   VISUAL UPDATES
===================================================== */
function updateTrail(){
  BALL_HIST.unshift(ballMesh.position.clone());
  if(BALL_HIST.length>8)BALL_HIST.pop();
  TRAIL.forEach((t,i)=>{if(BALL_HIST[i+1]){t.position.copy(BALL_HIST[i+1]);t.visible=true;}else t.visible=false;});
}

function updateShadow(){
  if(!shadowCircle)return;
  shadowCircle.position.x=ballBody.position.x;
  shadowCircle.position.z=ballBody.position.z;
  const h=ballBody.position.y;
  shadowCircle.material.opacity=Math.max(0,0.35-h*0.04);
  const s=Math.max(0.1,1-h*0.06);
  shadowCircle.scale.set(s,s,s);
}

function updateSwing(dt){
  P.forEach(p=>{
    if(!p.racketMesh)return;
    if(p.swingAnim>0){
      p.swingAnim-=dt*5;
      const t=Math.max(0,p.swingAnim);
      p.racketMesh.rotation.z=Math.sin(t*Math.PI)*(Math.PI/2);
      p.racketMesh.position.z=Math.sin(t*Math.PI)*0.3;
    }else{p.swingAnim=0;p.racketMesh.rotation.z=0;p.racketMesh.position.z=0;}
  });
}

function syncMeshes(){
  P.forEach(p=>{
    if(!p.mesh)return;
    p.mesh.position.set(p.pos.x,0.75,p.pos.z);
    const bx=ballBody.position.x-p.pos.x,bz=ballBody.position.z-p.pos.z;
    if(Math.abs(bx)+Math.abs(bz)>0.1)p.mesh.rotation.y=Math.atan2(bx,bz);
  });
}

/* =====================================================
   OOB CHECK
===================================================== */
function checkOOB(){
  if(GS.phase!=='PLAYING'&&GS.phase!=='SERVING')return;
  const p=ballBody.position;
  if(p.y<-2){ballBody.position.set(0,0.5,0);ballBody.velocity.set(0,0,0);return;}
  if((Math.abs(p.x)>COURT.H_W+3||Math.abs(p.z)>COURT.H_L+3)&&!GS.pointPending&&GS.phase==='PLAYING'){
    GS.pointPending=true;const wt=1-GS.lastHitTeam;
    showPointMsg('¡FUERA!',wt);
    setTimeout(()=>awardPoint(wt),600);
  }
}

/* =====================================================
   PAUSE / RESTART
===================================================== */
function togglePause(){
  if(GS.phase==='LOADING'||GS.phase==='MATCH_OVER')return;
  GS.paused=!GS.paused;
  document.getElementById('pause-overlay').style.display=GS.paused?'flex':'none';
}

function restartMatch(){
  document.getElementById('result-overlay').style.display='none';
  document.getElementById('pause-overlay').style.display='none';
  document.getElementById('point-overlay').style.display='none';
  Object.assign(GS,{
    phase:'WAITING_TO_SERVE',paused:false,
    servingTeam:0,servingPlayer:0,servingRight:true,serveAttempt:1,
    ballBounces:0,lastHitTeam:-1,lastHitPlayer:-1,ballSide:-1,
    matchWinners:[0,0],isDeuce:false,advantage:-1,isTiebreak:false,
    completedSets:[],currentSet:0,pointPending:false,
    score:{team1:{pts:0,games:0,sets:0},team2:{pts:0,games:0,sets:0}}
  });
  ballHitCooldown=0;powerHeld=0;isCharging=false;hitQ=lobQ=smashQ=false;
  resetPlayersDefault();resetBall();updateScoreboard();showServeOverlay();
}
window.restartMatch = restartMatch;

/* =====================================================
   LOADING
===================================================== */
function runLoading(){
  const bar=document.getElementById('loading-bar'),txt=document.getElementById('loading-text');
  const msgs=['Generando la cancha...','Preparando la fisica...','Entrenando la IA...','Cargando marcador...','¡Todo listo!'];
  let pct=0;
  const step=()=>{
    pct+=20;bar.style.width=pct+'%';
    txt.textContent=msgs[Math.floor((pct/100)*msgs.length)]||msgs[msgs.length-1];
    if(pct<100)setTimeout(step,280);
    else{
      setTimeout(()=>{
        const ov=document.getElementById('loading-overlay');
        ov.style.opacity='0';
        setTimeout(()=>{
          ov.style.display='none';
          GS.phase='WAITING_TO_SERVE';
          resetBall();showServeOverlay();updateScoreboard();
        },800);
      },300);
    }
  };
  setTimeout(step,200);
}

/* =====================================================
   MAIN LOOP
===================================================== */
const clock=new THREE.Clock();
let physAccum=0;
const PHYS_STEP=1/120;

function loop(){
  requestAnimationFrame(loop);
  const dt=Math.min(clock.getDelta(),0.05);

  if(GS.phase==='LOADING'){renderer.render(scene,camera);return;}

  if(!GS.paused&&GS.phase!=='MATCH_OVER'){
    physAccum+=dt;
    while(physAccum>=PHYS_STEP){world.step(PHYS_STEP);physAccum-=PHYS_STEP;}
    if(ballHitCooldown>0)ballHitCooldown-=dt;

    if (P[0].isHuman) {
      updateHuman(dt);
    } else {
      updateAI(P[0], dt);
    }
    updateAI(P[1],dt);updateAI(P[2],dt);updateAI(P[3],dt);

    ballMesh.position.copy(ballBody.position);
    ballMesh.quaternion.copy(ballBody.quaternion);

    checkOOB();
    syncMeshes();updateSwing(dt);updateTrail();updateShadow();
    updateCamera(dt);updateHUD(dt);
  }

  renderer.render(scene,camera);
}

/* =====================================================
   CONFIG LOADER
===================================================== */
function loadConfig(){
  // 1. Load Player Data
  try {
    const pData = JSON.parse(localStorage.getItem('padelPlayerData'));
    if (pData) {
      P[0].name = (pData.name || 'PLAYER').toUpperCase();
      const outfitColors = [0x2196F3, 0xf44336, 0x00C853, 0x9C27B0, 0xFF9800, 0x333333];
      if (pData.outfit !== undefined && outfitColors[pData.outfit] !== undefined) {
        playerColor = outfitColors[pData.outfit];
      }
    }
  } catch(e) {}

  // 2. Load Match Config
  try {
    const mConfig = JSON.parse(localStorage.getItem('padelMatchConfig'));
    if (mConfig) {
      GS.difficulty = mConfig.difficulty !== undefined ? mConfig.difficulty : 3;
      
      if (mConfig.mode === 'ai') {
        P[0].isHuman = false;
        document.getElementById('team1-name').textContent = "IA EQUIPO A";
        document.getElementById('team2-name').textContent = "IA EQUIPO B";
        document.getElementById('controls-hint').innerHTML = "🔴 MODO ESPECTADOR (IA vs IA)<br>Mira la partida en curso. Presiona [ C ] para cambiar camara.";
      } else {
        document.getElementById('team1-name').textContent = P[0].name;
        if (mConfig.mode === 'training') {
          document.getElementById('controls-hint').innerHTML = "🎓 MODO ENTRENAMIENTO<br>Practica tus golpes. WASD = mover | ESPACIO = golpe | Q = globo | E = smash";
        }
      }
      
      // Court indoor / outdoor adjustments
      if (mConfig.court === 'outdoor') {
        scene.background = new THREE.Color(0x02020a);
        scene.fog = new THREE.FogExp2(0x02020a, 0.018);
        renderer.setClearColor(0x02020a);
      }
    }
  } catch(e) {}
}

/* =====================================================
   INIT
===================================================== */
function init(){
  loadConfig();
  buildLighting();buildCourt();buildPlayers();buildBall();buildBallShadow();
  initPhysics();initControls();
  updateScoreboard();resetPlayersDefault();
  runLoading();loop();
}

init();
