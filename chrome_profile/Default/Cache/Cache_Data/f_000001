<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Padel Champions - Match</title>
  <script src="https://cdn.jsdelivr.net/npm/three@0.165.0/build/three.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/nipplejs/0.10.1/nipplejs.min.js"></script>
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Inter:wght@300;400;600&display=swap" rel="stylesheet">
  <style>
    *{margin:0;padding:0;box-sizing:border-box}
    body{overflow:hidden;background:#0a0a1a;font-family:'Inter',sans-serif}
    #game-canvas{position:fixed;top:0;left:0;width:100%;height:100%;display:block}
    #hud{position:fixed;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:10}
    #scoreboard{
      position:absolute;top:16px;left:50%;transform:translateX(-50%);
      display:flex;align-items:center;gap:20px;
      background:rgba(10,10,26,0.88);backdrop-filter:blur(16px);
      border:1px solid rgba(0,200,83,0.35);border-radius:20px;
      padding:12px 28px;min-width:420px
    }
    #team1-info,#team2-info{display:flex;align-items:center;gap:10px}
    #team1-name,#team2-name{font-family:'Orbitron',sans-serif;font-size:11px;font-weight:700;letter-spacing:.1em;color:#2196F3}
    #team2-name{color:#f44336}
    .game-score{font-family:'Orbitron',sans-serif;font-size:20px;font-weight:700;color:#fff}
    .point-score{font-family:'Orbitron',sans-serif;font-size:28px;font-weight:900;color:#FFD700;min-width:36px;text-align:center}
    .set-scores{display:flex;gap:4px}
    .set-score-badge{font-family:'Orbitron',sans-serif;font-size:11px;padding:2px 7px;background:rgba(255,255,255,.1);border-radius:6px;color:#aaa}
    #score-center{text-align:center;flex:0 0 auto}
    #set-indicator{font-family:'Orbitron',sans-serif;font-size:10px;color:#888;letter-spacing:.2em}
    #serve-dot{width:8px;height:8px;border-radius:50%;background:#FFD700;margin:4px auto;animation:pulse 1.5s infinite}
    @keyframes pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.5;transform:scale(1.5)}}
    #bottom-hud{
      position:absolute;bottom:20px;left:20px;
      background:rgba(10,10,26,.85);backdrop-filter:blur(10px);
      border:1px solid rgba(0,200,83,.2);border-radius:14px;
      padding:12px 16px;min-width:210px
    }
    .hud-label{font-size:10px;color:#888;letter-spacing:.1em;margin-bottom:4px;font-family:'Orbitron',sans-serif}
    #stamina-bar-bg,#power-bar-bg{background:rgba(255,255,255,.1);border-radius:6px;height:8px;margin-bottom:8px;overflow:hidden}
    #stamina-bar{height:100%;background:linear-gradient(90deg,#00C853,#69F0AE);border-radius:6px;width:100%;transition:width .3s}
    #power-bar{height:100%;background:linear-gradient(90deg,#FFD700,#FF6D00);border-radius:6px;width:0%;transition:width .05s}
    #camera-hint{font-size:10px;color:#555;margin-top:6px;font-family:'Orbitron',sans-serif}
    #controls-hint{font-size:9px;color:#444;margin-top:3px;font-family:'Inter',sans-serif;line-height:1.6}
    #ai-message{
      position:absolute;top:80px;right:20px;
      background:rgba(33,150,243,.9);backdrop-filter:blur(10px);
      border-radius:12px;padding:8px 16px;
      font-family:'Orbitron',sans-serif;font-size:12px;font-weight:700;
      color:#fff;opacity:0;transition:opacity .3s;max-width:200px;text-align:center;pointer-events:none
    }
    #ai-message.visible{opacity:1}
    #serve-overlay{
      position:absolute;bottom:60px;left:50%;transform:translateX(-50%);
      background:rgba(0,200,83,.9);border-radius:10px;padding:10px 24px;
      font-family:'Orbitron',sans-serif;font-size:13px;font-weight:700;
      color:#fff;animation:floatAnim 2s ease-in-out infinite;display:none
    }
    @keyframes floatAnim{0%,100%{transform:translateX(-50%) translateY(0)}50%{transform:translateX(-50%) translateY(-5px)}}
    #point-overlay{position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);text-align:center;z-index:50;pointer-events:none;display:none}
    #point-text{font-family:'Orbitron',sans-serif;font-size:58px;font-weight:900;color:#FFD700;text-shadow:0 0 40px rgba(255,215,0,.8);animation:pointAnim .3s ease-out}
    #point-subtext{font-family:'Orbitron',sans-serif;font-size:22px;color:#fff;margin-top:8px}
    @keyframes pointAnim{0%{transform:scale(.5);opacity:0}100%{transform:scale(1);opacity:1}}
    #pause-overlay,#result-overlay{
      position:fixed;top:0;left:0;width:100%;height:100%;
      background:rgba(0,0,0,.82);backdrop-filter:blur(8px);
      display:flex;align-items:center;justify-content:center;z-index:100
    }
    .menu-panel,.result-panel{
      background:rgba(10,10,26,.97);border:1px solid rgba(0,200,83,.4);
      border-radius:24px;padding:40px;text-align:center;min-width:320px
    }
    .menu-panel h2{font-family:'Orbitron',sans-serif;color:#FFD700;font-size:28px;margin-bottom:24px}
    .menu-panel button,.result-panel button{
      display:block;width:100%;margin:8px 0;padding:14px;
      background:rgba(0,200,83,.2);border:1px solid rgba(0,200,83,.4);
      border-radius:12px;color:#fff;font-family:'Orbitron',sans-serif;
      font-size:13px;cursor:pointer;pointer-events:all;transition:all .2s
    }
    .menu-panel button:hover,.result-panel button:hover{background:rgba(0,200,83,.4);transform:translateY(-2px)}
    #result-title{font-family:'Orbitron',sans-serif;font-size:36px;font-weight:900;margin-bottom:12px}
    #result-score{font-size:18px;color:#aaa;margin-bottom:20px;font-family:'Orbitron',sans-serif}
    #result-stats{display:flex;gap:16px;justify-content:center;margin-bottom:24px}
    .stat-card{background:rgba(255,255,255,.06);border-radius:12px;padding:12px 18px;text-align:center}
    .stat-value{font-family:'Orbitron',sans-serif;font-size:24px;color:#00C853}
    .stat-label{font-size:11px;color:#888;margin-top:4px}
    #loading-overlay{
      position:fixed;top:0;left:0;width:100%;height:100%;background:#0a0a1a;
      display:flex;flex-direction:column;align-items:center;justify-content:center;z-index:200;transition:opacity .8s
    }
    .loading-logo{
      font-family:'Orbitron',sans-serif;font-size:38px;font-weight:900;
      background:linear-gradient(135deg,#00C853,#FFD700);-webkit-background-clip:text;
      -webkit-text-fill-color:transparent;margin-bottom:40px;animation:loadGlow 2s ease-in-out infinite
    }
    @keyframes loadGlow{0%,100%{filter:drop-shadow(0 0 10px rgba(0,200,83,.5))}50%{filter:drop-shadow(0 0 30px rgba(255,215,0,.5))}}
    .loading-bar-bg{width:300px;height:4px;background:rgba(255,255,255,.1);border-radius:2px}
    #loading-bar{height:100%;background:linear-gradient(90deg,#00C853,#FFD700);border-radius:2px;width:0%;transition:width .4s}
    #loading-text{color:#888;font-size:13px;margin-top:16px;letter-spacing:.1em}
    #mobile-controls{position:fixed;bottom:0;width:100%;z-index:20;display:none;pointer-events:all}
    #joystick-zone{position:fixed;bottom:20px;left:20px;width:130px;height:130px}
    #shot-buttons{position:fixed;bottom:20px;right:20px;display:flex;flex-direction:column;gap:10px}
    .shot-btn{padding:14px 20px;border-radius:12px;border:1px solid rgba(0,200,83,.5);background:rgba(0,200,83,.25);color:#fff;font-family:'Orbitron',sans-serif;font-size:12px;cursor:pointer;font-weight:700;min-width:100px;backdrop-filter:blur(10px);touch-action:manipulation}
    .shot-btn:active{background:rgba(0,200,83,.6)}
    @media(max-width:768px){
      #mobile-controls{display:block}
      #camera-hint,#controls-hint{display:none}
      #scoreboard{min-width:280px;padding:8px 14px;gap:12px}
      .point-score{font-size:20px}
      .game-score{font-size:16px}
    }
  </style>
</head>
<body>
  <canvas id="game-canvas"></canvas>
  <div id="hud">
    <div id="scoreboard">
      <div id="team1-info">
        <span id="team1-name">TU EQUIPO</span>
        <div id="team1-sets" class="set-scores"></div>
        <span id="team1-games" class="game-score">0</span>
        <span id="team1-points" class="point-score">0</span>
      </div>
      <div id="score-center">
        <div id="set-indicator">SET 1</div>
        <div id="serve-dot"></div>
      </div>
      <div id="team2-info">
        <span id="team2-points" class="point-score">0</span>
        <span id="team2-games" class="game-score">0</span>
        <div id="team2-sets" class="set-scores"></div>
        <span id="team2-name">RIVALES</span>
      </div>
    </div>
    <div id="bottom-hud">
      <div class="hud-label">RESISTENCIA</div>
      <div id="stamina-bar-bg"><div id="stamina-bar"></div></div>
      <div class="hud-label">POTENCIA</div>
      <div id="power-bar-bg"><div id="power-bar"></div></div>
      <div id="camera-hint">[ C ] Camara &nbsp;|&nbsp; [ P ] Pausa</div>
      <div id="controls-hint">WASD = mover &nbsp;|&nbsp; ESPACIO = golpear<br>Q = lob &nbsp;|&nbsp; E = smash &nbsp;|&nbsp; SHIFT = sprint</div>
    </div>
    <div id="ai-message"></div>
    <div id="serve-overlay">&#11014; ESPACIO para sacar</div>
  </div>
  <div id="mobile-controls">
    <div id="joystick-zone"></div>
    <div id="shot-buttons">
      <button id="btn-hit" class="shot-btn">&#127934; HIT</button>
      <button id="btn-lob" class="shot-btn">&#127769; LOB</button>
      <button id="btn-smash" class="shot-btn">&#9889; SMASH</button>
    </div>
  </div>
  <div id="pause-overlay" style="display:none">
    <div class="menu-panel">
      <h2>&#9208; PAUSA</h2>
      <button id="btn-resume">&#9654; CONTINUAR</button>
      <button onclick="restartMatch()">&#128260; REINICIAR</button>
      <button onclick="window.location.href='index.html'">🏠 MENU PRINCIPAL</button>
    </div>
  </div>
  <div id="point-overlay" style="display:none">
    <div id="point-text"></div>
    <div id="point-subtext"></div>
  </div>
  <div id="result-overlay" style="display:none">
    <div class="result-panel">
      <div id="result-title"></div>
      <div id="result-score"></div>
      <div id="result-stats"></div>
      <button onclick="restartMatch()">&#128260; OTRA PARTIDA</button>
      <button onclick="window.location.href='index.html'">🏠 MENU PRINCIPAL</button>
    </div>
  </div>
  <div id="loading-overlay">
    <div class="loading-logo">PADEL CHAMPIONS</div>
    <div class="loading-bar-bg"><div id="loading-bar"></div></div>
    <div id="loading-text">Preparando la cancha...</div>
  </div>

<script type="module">
import * as CANNON from 'https://cdn.jsdelivr.net/npm/cannon-es@0.20.0/dist/cannon-es.min.js';

/* =====================================================
   CONSTANTS
===================================================== */
const COURT={W:10,H_W:5,L:20,H_L:10,NET_H:0.92,WALL_H:4,GLASS_H:3,SERVICE_LINE:3,BALL_R:0.065};
const PLAYER_SPEED=6.0,SPRINT_SPEED=9.5,STAMINA_DRAIN=0.28,STAMINA_RECOVER=0.18,MAX_POWER_TIME=0.85;
const SHOT_SPEEDS={
  drive:{min:14,max:32,upY:2.8},
  lob:{min:7,max:13,upY:10},
  smash:{min:28,max:48,upY:-0.5},
  volley:{min:16,max:28,upY:1.5},
  bandeja:{min:18,max:30,upY:5}
};
const PL=['0','15','30','40'];

/* =====================================================
   GAME STATE
===================================================== */
const GS={
  phase:'LOADING',paused:false,
  servingTeam:0,servingPlayer:0,servingRight:true,serveAttempt:1,
  ballBounces:0,lastHitTeam:-1,lastHitPlayer:-1,ballSide:-1,
  cameraMode:0,matchWinners:[0,0],difficulty:3,
  score:{team1:{pts:0,games:0,sets:0},team2:{pts:0,games:0,sets:0}},
  isDeuce:false,advantage:-1,isTiebreak:false,
  completedSets:[],currentSet:0,pointPending:false
};

/* =====================================================
   PLAYERS
===================================================== */
const P=[
  {id:0,team:0,isHuman:true,name:'PLAYER',pos:new THREE.Vector3(1.5,0,-7),stamina:1,facing:1,mesh:null,racketMesh:null,hitCooldown:0,swingAnim:0},
  {id:1,team:0,isHuman:false,name:'PARTNER',pos:new THREE.Vector3(-1.5,0,-7),stamina:1,facing:1,mesh:null,racketMesh:null,hitCooldown:0,swingAnim:0,_serveTimer:0},
  {id:2,team:1,isHuman:false,name:'RIVAL1',pos:new THREE.Vector3(-1.5,0,7),stamina:1,facing:-1,mesh:null,racketMesh:null,hitCooldown:0,swingAnim:0,_serveTimer:0},
  {id:3,team:1,isHuman:false,name:'RIVAL2',pos:new THREE.Vector3(1.5,0,7),stamina:1,facing:-1,mesh:null,racketMesh:null,hitCooldown:0,swingAnim:0,_serveTimer:0}
];

let playerColor = 0x1E88E5;

/* =====================================================
   THREE.JS
===================================================== */
const scene=new THREE.Scene();
scene.background=new THREE.Color(0x0a0a1a);
scene.fog=new THREE.FogExp2(0x0a0a1a,0.026);

const camera=new THREE.PerspectiveCamera(60,innerWidth/innerHeight,0.1,150);
const renderer=new THREE.WebGLRenderer({canvas:document.getElementById('game-canvas'),antialias:true});
renderer.setPixelRatio(Math.min(devicePixelRatio,2));
renderer.setSize(innerWidth,innerHeight);
renderer.shadowMap.enabled=true;
renderer.shadowMap.type=THREE.PCFSoftShadowMap;
renderer.toneMapping=THREE.ACESFilmicToneMapping;
renderer.toneMappingExposure=1.1;

const CAM_POSITIONS=[
  {pos:new THREE.Vector3(17,9,0.5),look:new THREE.Vector3(0,1.5,0)},
  {pos:new THREE.Vector3(0,6.5,-15),look:new THREE.Vector3(0,2,3)},
  {pos:new THREE.Vector3(0,24,0.1),look:new THREE.Vector3(0,0,0)}
];
let camPos=CAM_POSITIONS[0].pos.clone();
let camLook=CAM_POSITIONS[0].look.clone();
camera.position.copy(camPos);
camera.lookAt(camLook);

window.addEventListener('resize',()=>{
  camera.aspect=innerWidth/innerHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(innerWidth,innerHeight);
});

/* =====================================================
   COURT BUILD
===================================================== */
function buildLine(w,h,d,x,y,z,mat){
  const m=new THREE.Mesh(new THREE.BoxGeometry(w,h,d),mat);
  m.position.set(x,y,z);scene.add(m);
}

function buildCourt(){
  // Floor
  const fGeo=new THREE.PlaneGeometry(COURT.W,COURT.L);
  const fMat=new THREE.MeshStandardMaterial({color:0x1a6b2a,roughness:0.88,metalness:0.04});
  const floor=new THREE.Mesh(fGeo,fMat);
  floor.rotation.x=-Math.PI/2;floor.receiveShadow=true;scene.add(floor);

  // Lines
  const lm=new THREE.MeshBasicMaterial({color:0xffffff,opacity:0.85,transparent:true});
  buildLine(COURT.W,0.02,0.06,0,0.001,-COURT.H_L,lm);
  buildLine(COURT.W,0.02,0.06,0,0.001,COURT.H_L,lm);
  buildLine(0.06,0.02,COURT.L,-COURT.H_W,0.001,0,lm);
  buildLine(0.06,0.02,COURT.L,COURT.H_W,0.001,0,lm);
  buildLine(COURT.W,0.02,0.06,0,0.001,-COURT.SERVICE_LINE,lm);
  buildLine(COURT.W,0.02,0.06,0,0.001,COURT.SERVICE_LINE,lm);
  buildLine(0.06,0.02,COURT.SERVICE_LINE*2,0,0.001,0,lm);

  // Net
  const nm=new THREE.MeshStandardMaterial({color:0xdddddd,roughness:0.9});
  const net=new THREE.Mesh(new THREE.BoxGeometry(COURT.W+0.2,COURT.NET_H,0.05),nm);
  net.position.set(0,COURT.NET_H/2,0);net.castShadow=true;scene.add(net);
  // Strap
  const sm2=new THREE.MeshStandardMaterial({color:0xff3333});
  const strap=new THREE.Mesh(new THREE.BoxGeometry(0.12,COURT.NET_H*0.85,0.06),sm2);
  strap.position.set(0,(COURT.NET_H*0.85)/2,0);scene.add(strap);
  // Posts
  const pm=new THREE.MeshStandardMaterial({color:0xbbbbbb,metalness:0.75,roughness:0.2});
  [-COURT.H_W,COURT.H_W].forEach(x=>{
    const p=new THREE.Mesh(new THREE.CylinderGeometry(0.05,0.05,COURT.NET_H+0.15,8),pm);
    p.position.set(x,(COURT.NET_H+0.15)/2,0);scene.add(p);
  });

  // Glass walls
  const gm=new THREE.MeshPhysicalMaterial({color:0x88ccff,transparent:true,opacity:0.22,roughness:0,metalness:0.1,side:THREE.DoubleSide});
  function addGlass(wx,wy,wz,px,py,pz){
    const m=new THREE.Mesh(new THREE.BoxGeometry(wx,wy,wz),gm);
    m.position.set(px,py,pz);scene.add(m);
  }
  const gh=COURT.GLASS_H,gy=gh/2;
  addGlass(COURT.W,gh,0.1,0,gy,-COURT.H_L);
  addGlass(COURT.W,gh,0.1,0,gy,COURT.H_L);
  addGlass(0.1,gh,COURT.L,-COURT.H_W,gy,0);
  addGlass(0.1,gh,COURT.L,COURT.H_W,gy,0);

  // Frame posts
  const frm=new THREE.MeshStandardMaterial({color:0x444455,metalness:0.8,roughness:0.3});
  function addPost(px,py,pz,h){
    const m=new THREE.Mesh(new THREE.CylinderGeometry(0.045,0.045,h,6),frm);
    m.position.set(px,py,pz);scene.add(m);
  }
  [[-5,0,-10],[5,0,-10],[-5,0,10],[5,0,10]].forEach(([x,,z])=>addPost(x,gh/2,z,gh+0.3));
  addPost(-5,gh/2,0,gh+0.2);addPost(5,gh/2,0,gh+0.2);

  // Fence
  const fenceMat=new THREE.MeshBasicMaterial({color:0x778899,wireframe:true,transparent:true,opacity:0.55});
  function addFence(wx,fh,wz,px,py,pz){
    const m=new THREE.Mesh(new THREE.BoxGeometry(wx,fh,wz),fenceMat);
    m.position.set(px,py,pz);scene.add(m);
  }
  const fh2=1.2,fy2=gh+fh2/2;
  addFence(COURT.W,fh2,0.12,0,fy2,-COURT.H_L);
  addFence(COURT.W,fh2,0.12,0,fy2,COURT.H_L);
  addFence(0.12,fh2,COURT.L,-COURT.H_W,fy2,0);
  addFence(0.12,fh2,COURT.L,COURT.H_W,fy2,0);

  buildStadium();
}

function buildStadium(){
  const bm=new THREE.MeshStandardMaterial({color:0x16162a,roughness:0.95});
  [-8.5,8.5].forEach(x=>{const s=new THREE.Mesh(new THREE.BoxGeometry(3.5,5,22),bm);s.position.set(x,2.5,0);scene.add(s);});
  [-14,14].forEach(z=>{const s=new THREE.Mesh(new THREE.BoxGeometry(16,3.5,3.5),bm);s.position.set(0,1.75,z);scene.add(s);});
  const sm=new THREE.MeshStandardMaterial({color:0x111120,roughness:0.9});
  const sf=new THREE.Mesh(new THREE.PlaneGeometry(40,40),sm);sf.rotation.x=-Math.PI/2;sf.position.y=-0.01;scene.add(sf);
  const cc=[0xff6b6b,0x4ecdc4,0x45b7d1,0xffd93d,0x6bcb77,0xee82ee,0xff9f43];
  for(let i=0;i<100;i++){
    const c=cc[i%cc.length];
    const m=new THREE.Mesh(new THREE.SphereGeometry(0.23,6,5),new THREE.MeshBasicMaterial({color:c}));
    const side=Math.random()>0.5?8+Math.random()*1.2:-8-Math.random()*1.2;
    m.position.set(side,1.5+Math.random()*2,(Math.random()-0.5)*20);scene.add(m);
  }
  for(let i=0;i<40;i++){
    const c=cc[i%cc.length];
    const m=new THREE.Mesh(new THREE.SphereGeometry(0.2,6,5),new THREE.MeshBasicMaterial({color:c}));
    const ze=Math.random()>0.5?13+Math.random():-13-Math.random();
    m.position.set((Math.random()-0.5)*14,1.2+Math.random()*1.5,ze);scene.add(m);
  }
}

/* =====================================================
   PLAYERS & BALL MESHES
===================================================== */
const TC=[0x1565C0,0xC62828];

function buildPlayers(){
  P.forEach(p=>{
    const g=new THREE.Group();
    const bm=new THREE.MeshStandardMaterial({color:p.id===0?playerColor:TC[p.team],roughness:0.7,metalness:0.15});
    const body=new THREE.Mesh(new THREE.CapsuleGeometry(0.28,0.9,4,8),bm);
    body.castShadow=true;g.add(body);
    const head=new THREE.Mesh(new THREE.SphereGeometry(0.18,10,8),new THREE.MeshStandardMaterial({color:0xFFD5A8,roughness:0.7}));
    head.position.y=0.73;head.castShadow=true;g.add(head);
    if(p.id===0){
      const ring=new THREE.Mesh(new THREE.TorusGeometry(0.3,0.04,6,16),new THREE.MeshBasicMaterial({color:0xFFD700}));
      ring.position.y=1.1;ring.rotation.x=Math.PI/2;g.add(ring);
    }
    const rg=new THREE.Group();
    const rm=new THREE.MeshStandardMaterial({color:p.isHuman?0xFFD700:0xaaaacc,metalness:0.4,roughness:0.5});
    const handle=new THREE.Mesh(new THREE.CylinderGeometry(0.025,0.025,0.38,6),rm);
    handle.rotation.z=Math.PI/3;rg.add(handle);
    const rhead=new THREE.Mesh(new THREE.BoxGeometry(0.44,0.06,0.52),new THREE.MeshStandardMaterial({color:0xeeeeee,roughness:0.5,metalness:0.2}));
    rhead.position.set(0.28,0.24,0);rg.add(rhead);
    const strm=new THREE.MeshBasicMaterial({color:0x333333});
