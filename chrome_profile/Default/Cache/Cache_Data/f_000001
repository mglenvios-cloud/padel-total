/* =====================================================
   PHYSICS
===================================================== */
let world,ballBody,floorBody,netBody;
const wallBodies=[];
let bMat,wMat,fMat;
let ballHitCooldown=0;

function initPhysics(){
  world=new CANNON.World();
  world.gravity.set(0,-9.82,0);
  world.broadphase=new CANNON.NaiveBroadphase();
  world.solver.iterations=15;
  bMat=new CANNON.Material('ball');wMat=new CANNON.Material('wall');fMat=new CANNON.Material('floor');
  world.addContactMaterial(new CANNON.ContactMaterial(bMat,fMat,{restitution:0.72,friction:0.3,contactEquationStiffness:1e7}));
  world.addContactMaterial(new CANNON.ContactMaterial(bMat,wMat,{restitution:0.75,friction:0.08}));

  floorBody=new CANNON.Body({mass:0,material:fMat});
  floorBody.addShape(new CANNON.Plane());
  floorBody.quaternion.setFromEuler(-Math.PI/2,0,0);
  world.addBody(floorBody);

  ballBody=new CANNON.Body({mass:0.057,material:bMat,linearDamping:0.1,angularDamping:0.35});
  ballBody.addShape(new CANNON.Sphere(COURT.BALL_R));
  world.addBody(ballBody);

  function addBox(hw,hh,hd,x,y,z){
    const b=new CANNON.Body({mass:0,material:wMat});
    b.addShape(new CANNON.Box(new CANNON.Vec3(hw,hh,hd)));
    b.position.set(x,y,z);world.addBody(b);return b;
  }
  const wh=COURT.WALL_H/2;
  wallBodies.push(addBox(COURT.H_W,wh,0.07,0,wh,-COURT.H_L));
  wallBodies.push(addBox(COURT.H_W,wh,0.07,0,wh,COURT.H_L));
  wallBodies.push(addBox(0.07,wh,COURT.H_L,-COURT.H_W,wh,0));
  wallBodies.push(addBox(0.07,wh,COURT.H_L,COURT.H_W,wh,0));

  netBody=new CANNON.Body({mass:0,material:wMat});
  netBody.addShape(new CANNON.Box(new CANNON.Vec3(COURT.H_W+0.1,COURT.NET_H/2,0.035)));
  netBody.position.set(0,COURT.NET_H/2,0);
  world.addBody(netBody);

  ballBody.addEventListener('collide',onCollide);
}

function onCollide(evt){
  const h=evt.body,pos=ballBody.position;
  if(h===floorBody){playBounce();handleFloorBounce(pos);}
  else if(h===netBody){playWallHit();if(GS.phase==='SERVING')handleFault();}
  else if(wallBodies.includes(h))playWallHit();
}

function handleFloorBounce(pos){
  if(GS.phase==='SERVING'){
    if(inServiceBox(pos)){GS.phase='PLAYING';GS.ballBounces=0;GS.ballSide=1-GS.servingTeam;hideServeOverlay();}
    else handleFault();
    return;
  }
  if(GS.phase!=='PLAYING')return;
  const side=pos.z<0?0:1;
  GS.ballSide=side;GS.ballBounces++;
  if(GS.ballBounces>=2&&!GS.pointPending){
    const wt=1-side;GS.pointPending=true;
    showPointMsg('¡DOBLE BOTE!',wt);
    setTimeout(()=>awardPoint(wt),600);
  }
}

function inServiceBox(pos){
  const st=GS.servingTeam,sr=GS.servingRight;
  const cz=st===0?(pos.z>0&&pos.z<COURT.SERVICE_LINE):(pos.z<0&&pos.z>-COURT.SERVICE_LINE);
  const cx=sr?(pos.x<0):(pos.x>=0);
  return cz&&cx;
}

function handleFault(){
  if(GS.phase!=='SERVING'||GS.pointPending)return;
  GS.serveAttempt++;
  if(GS.serveAttempt>2){
    GS.pointPending=true;
    showPointMsg('DOBLE FALTA',1-GS.servingTeam);
    setTimeout(()=>{GS.serveAttempt=1;awardPoint(1-GS.servingTeam);},600);
  }else{
    showMsg('FALTA - 2do SAQUE');
    setTimeout(()=>{if(GS.phase==='SERVING'){GS.phase='WAITING_TO_SERVE';resetBall();showServeOverlay();}},1600);
  }
}

/* =====================================================
   CONTROLS
===================================================== */
const keys={};
let powerHeld=0,isCharging=false,hitQ=false,lobQ=false,smashQ=false;
let joyX=0,joyZ=0;

function initControls(){
  window.addEventListener('keydown',e=>{
    if(keys[e.code])return;keys[e.code]=true;
    if(e.code==='Escape'||e.code==='KeyP')togglePause();
    if(e.code==='KeyC')cycleCamera();
    if(e.code==='Space'){
      e.preventDefault();
      if(GS.phase==='WAITING_TO_SERVE'&&!GS.paused)executeServe();
      else isCharging=true;
    }
    if(e.code==='KeyQ')lobQ=true;
    if(e.code==='KeyE')smashQ=true;
    if(e.code==='KeyF')hitQ=true;
  });
  window.addEventListener('keyup',e=>{
    keys[e.code]=false;
    if(e.code==='Space'){if(GS.phase==='PLAYING'&&isCharging){hitQ=true;}isCharging=false;}
  });

  document.getElementById('btn-hit').addEventListener('touchstart',e=>{e.preventDefault();isCharging=true;});
  document.getElementById('btn-hit').addEventListener('touchend',e=>{e.preventDefault();hitQ=true;isCharging=false;});
  document.getElementById('btn-lob').addEventListener('touchstart',e=>{e.preventDefault();lobQ=true;});
  document.getElementById('btn-smash').addEventListener('touchstart',e=>{e.preventDefault();smashQ=true;});
  document.getElementById('btn-resume').addEventListener('click',togglePause);

  document.getElementById('game-canvas').addEventListener('touchstart',e=>{
    if(GS.phase==='WAITING_TO_SERVE'&&!GS.paused)executeServe();
  });

  const mob=/Mobi|Android/i.test(navigator.userAgent)||innerWidth<768;
  if(mob||'ontouchstart' in window){
    document.getElementById('mobile-controls').style.display='block';
    if(typeof nipplejs!=='undefined'){
      const mgr=nipplejs.create({zone:document.getElementById('joystick-zone'),mode:'static',position:{left:'65px',bottom:'65px'},color:'#00C853',size:120});
      mgr.on('move',(_,d)=>{if(d.vector){joyX=d.vector.x;joyZ=-d.vector.y;}});
      mgr.on('end',()=>{joyX=0;joyZ=0;});
    }
  }
}

function getMov(){
  let mx=joyX,mz=joyZ;
  if(keys['ArrowLeft']||keys['KeyA'])mx-=1;
  if(keys['ArrowRight']||keys['KeyD'])mx+=1;
  if(keys['ArrowUp']||keys['KeyW'])mz+=1;
  if(keys['ArrowDown']||keys['KeyS'])mz-=1;
  const len=Math.sqrt(mx*mx+mz*mz);
  if(len>1){mx/=len;mz/=len;}
  return{x:mx,z:mz};
}

/* =====================================================
   SERVE
===================================================== */
function executeServe(){
  if(GS.phase!=='WAITING_TO_SERVE'||GS.paused)return;
  initAudio();
  const server=P[GS.servingPlayer];
  const power=0.55+Math.random()*0.35;
  const sr=GS.servingRight;
  const tx=sr?-2.5:2.5;
  const tz=server.team===0?1.8:-1.8;
  const dx=tx-server.pos.x,dz=tz-server.pos.z;
  const h=Math.sqrt(dx*dx+dz*dz);
  ballBody.position.set(server.pos.x,0.5,server.pos.z);
  ballBody.velocity.set((dx/h)*13*power+(Math.random()-0.5)*0.8,4.2,(dz/h)*13*power+(Math.random()-0.5)*0.8);
  ballBody.angularVelocity.set(0,0,0);
  GS.phase='SERVING';GS.ballBounces=0;GS.lastHitTeam=server.team;GS.lastHitPlayer=server.id;
  hideServeOverlay();playBallHit(power);swingRacket(server);
}

/* =====================================================
   SHOT
===================================================== */
function executeShot(player,type,power){
  if(ballHitCooldown>0)return;
  const sp=SHOT_SPEEDS[type]||SHOT_SPEEDS.drive;
  const speed=sp.min+power*(sp.max-sp.min);
  const dir=player.facing;
  const bx=ballBody.position.x;
  const aimX=Math.max(-4.2,Math.min(4.2,bx+(Math.random()-0.5)*4));
  const dx=aimX-bx;
  let vy=sp.upY;
  if(type==='lob')vy=Math.max(8,vy);
  if(type==='smash')vy=Math.min(-0.3,vy);
  ballBody.velocity.set(dx*0.45,vy,dir*speed);
  ballBody.angularVelocity.set((Math.random()-0.5)*6,(Math.random()-0.5)*4,(Math.random()-0.5)*6);
  GS.lastHitTeam=player.team;GS.lastHitPlayer=player.id;GS.ballBounces=0;
  ballHitCooldown=0.38;
  playBallHit(power);swingRacket(player);
  if(!player.isHuman&&Math.random()<0.28){
    const msgs=['¡Voy yo!','¡Tuya!','¡Subimos!','¡Vamos!','¡Dale!','¡Bien!','¡Fuera!'];
    showAIMsg(msgs[Math.floor(Math.random()*msgs.length)]);
  }
  if(player.team===0)GS.matchWinners[0]++;
  else GS.matchWinners[1]++;
}

function swingRacket(player){player.swingAnim=1.0;}

function canHit(player){
  if(ballHitCooldown>0||player.hitCooldown>0)return false;
  const bPos=ballBody.position,pPos=player.pos;
  const dx=bPos.x-pPos.x,dz=bPos.z-pPos.z;
  const dist=Math.sqrt(dx*dx+dz*dz);
  const onSide=player.team===0?(bPos.z<0.4):(bPos.z>-0.4);
  return dist<1.7&&onSide&&bPos.y>-0.05&&bPos.y<3.2;
}

function pickShot(ballY,isAI){
  if(ballY>2.3)return'smash';
  if(ballY>1.6)return'bandeja';
  if(ballY<0.35&&isAI)return'lob';
  return'drive';
}

/* =====================================================
   HUMAN UPDATE
===================================================== */
function updateHuman(dt){
  const p=P[0];
  if(GS.paused||GS.phase==='LOADING')return;
  const mov=getMov();
  const sprint=(keys['ShiftLeft']||keys['ShiftRight'])&&(Math.abs(mov.x)+Math.abs(mov.z)>0.1);
  const spd=(sprint&&p.stamina>0.05)?SPRINT_SPEED:PLAYER_SPEED;
  p.pos.x+=mov.x*spd*dt;
  p.pos.z-=mov.z*spd*dt;
  p.pos.x=Math.max(-COURT.H_W+0.35,Math.min(COURT.H_W-0.35,p.pos.x));
  p.pos.z=Math.max(-COURT.H_L+0.35,Math.min(-0.25,p.pos.z));
  if(sprint)p.stamina=Math.max(0,p.stamina-STAMINA_DRAIN*dt);
  else p.stamina=Math.min(1,p.stamina+STAMINA_RECOVER*dt);
  if(isCharging&&GS.phase==='PLAYING')powerHeld=Math.min(1,powerHeld+dt/MAX_POWER_TIME);
  if(GS.phase==='PLAYING'){
    if(canHit(p)){
      if(hitQ){hitQ=false;executeShot(p,pickShot(ballBody.position.y,false),Math.max(0.3,powerHeld));powerHeld=0;p.hitCooldown=0.4;}
      else if(lobQ){lobQ=false;executeShot(p,'lob',0.75);p.hitCooldown=0.4;}
      else if(smashQ){smashQ=false;executeShot(p,'smash',0.95);p.hitCooldown=0.4;}
    }else{hitQ=lobQ=smashQ=false;}
  }
  if(p.hitCooldown>0)p.hitCooldown-=dt;
}

/* =====================================================
   AI UPDATE
===================================================== */
function updateAI(player,dt){
  if(GS.paused||GS.phase==='LOADING')return;
  const bPos=ballBody.position,bVel=ballBody.velocity;
  const onSide=player.team===0?(bPos.z<0):(bPos.z>0);
  const homeX=(player.id===1||player.id===2)?-2:2;
  const homeZ=player.team===0?-7:7;
  let target;
  if(onSide&&GS.phase==='PLAYING'){
    const spd3=Math.sqrt(bVel.x*bVel.x+bVel.z*bVel.z);
    const t=spd3>0.5?Math.abs(bPos.z-(player.team===0?-0.3:0.3))/Math.max(0.5,Math.abs(bVel.z)):0;
    const px=bPos.x+bVel.x*Math.min(t,1.5);
    const pz=bPos.z+bVel.z*Math.min(t,1.5);
    const err=(5-GS.difficulty)*0.4;
    const cz=player.team===0?Math.max(-COURT.H_L+0.5,Math.min(-0.3,pz)):Math.max(0.3,Math.min(COURT.H_L-0.5,pz));
    target=new THREE.Vector3(Math.max(-COURT.H_W+0.5,Math.min(COURT.H_W-0.5,px+(Math.random()-0.5)*err)),0,cz+(Math.random()-0.5)*err);
  }else{
    const near=Math.abs(bPos.z)<5;
    const netZ=player.team===0?-2.5:2.5;
    target=new THREE.Vector3(homeX+(Math.random()-0.5)*0.5,0,near&&GS.phase==='PLAYING'?netZ:homeZ);
  }
  const dx=target.x-player.pos.x,dz=target.z-player.pos.z;
  const dist=Math.sqrt(dx*dx+dz*dz);
  if(dist>0.12){
    const spd=PLAYER_SPEED*(0.65+0.07*GS.difficulty);
    player.pos.x+=(dx/dist)*spd*dt;
    player.pos.z+=(dz/dist)*spd*dt;
  }
  player.pos.x=Math.max(-COURT.H_W+0.35,Math.min(COURT.H_W-0.35,player.pos.x));
  if(player.team===0)player.pos.z=Math.max(-COURT.H_L+0.35,Math.min(-0.2,player.pos.z));
  else player.pos.z=Math.max(0.2,Math.min(COURT.H_L-0.35,player.pos.z));
  if(player.hitCooldown>0)player.hitCooldown-=dt;

  if(GS.phase==='WAITING_TO_SERVE'&&player.id===GS.servingPlayer){
    player._serveTimer=(player._serveTimer||0)+dt;
    if(player._serveTimer>(1.2-GS.difficulty*0.1)){player._serveTimer=0;executeServe();}
    return;
  }else{player._serveTimer=0;}

  if(GS.phase==='PLAYING'&&onSide&&canHit(player)&&player.hitCooldown<=0){
    const hc=0.55+0.09*GS.difficulty;
    if(Math.random()<hc){
      executeShot(player,pickShot(bPos.y,true),0.3+Math.random()*0.6*(GS.difficulty/5));
      player.hitCooldown=0.45;
    }
  }
}

/* =====================================================
   SCORING
===================================================== */
function awardPoint(team){
  if(GS.phase==='MATCH_OVER')return;
  GS.phase='POINT_AWARDED';GS.pointPending=false;
  const sc=GS.score,tK=team===0?'team1':'team2',oK=team===0?'team2':'team1';
  let ptxt='';
  if(GS.isTiebreak){
    sc[tK].pts++;
    const t1=sc.team1.pts,t2=sc.team2.pts;
    const mx=Math.max(t1,t2);
    if(mx>=7&&Math.abs(t1-t2)>=2)winSet(team);
    else ptxt=`${t1} - ${t2}`;
  }else if(GS.isDeuce){
    if(GS.advantage===team){winGame(team);ptxt='¡JUEGO!';}
    else if(GS.advantage===-1){GS.advantage=team;ptxt='VENTAJA '+(team===0?'TU EQUIPO':'RIVALES');}
    else{GS.advantage=-1;ptxt='DEUCE';}
  }else{
    sc[tK].pts++;
    const p1=sc.team1.pts,p2=sc.team2.pts;
    if(p1>=3&&p2>=3){GS.isDeuce=true;GS.advantage=-1;ptxt='DEUCE';}
    else if(sc[tK].pts>=4){winGame(team);ptxt='¡JUEGO!';}
    else ptxt=PL[Math.min(p1,3)]+' - '+PL[Math.min(p2,3)];
  }
  if(ptxt)showPointMsg(ptxt,team);
  playPointWon();updateScoreboard();
  if(GS.phase!=='MATCH_OVER')setTimeout(()=>resetAfterPoint(),2600);
}

function winGame(team){
  const sc=GS.score,tK=team===0?'team1':'team2',oK=team===0?'team2':'team1';
  sc.team1.pts=0;sc.team2.pts=0;GS.isDeuce=false;GS.advantage=-1;
  sc[tK].games++;
  const g1=sc.team1.games,g2=sc.team2.games;
  if(g1===6&&g2===6){GS.isTiebreak=true;sc.team1.pts=0;sc.team2.pts=0;showMsg('¡TIEBREAK!');}
  else if(sc[tK].games>=6&&(sc[tK].games-sc[oK].games)>=2)winSet(team);
}

function winSet(team){
  const sc=GS.score,tK=team===0?'team1':'team2';
  GS.completedSets.push({t1:sc.team1.games,t2:sc.team2.games});
  sc[tK].sets++;sc.team1.games=0;sc.team2.games=0;sc.team1.pts=0;sc.team2.pts=0;
  GS.isTiebreak=false;GS.isDeuce=false;GS.advantage=-1;GS.currentSet++;
  if(sc.team1.sets>=2||sc.team2.sets>=2){endMatch(team);return;}
  showMsg('¡SET '+(GS.currentSet+1)+'!');
  GS.servingTeam=1-GS.servingTeam;GS.servingPlayer=GS.servingTeam===0?0:2;
  updateScoreboard();
}

function endMatch(wt){
  GS.phase='MATCH_OVER';
  const win=wt===0;
  try{
    let st;
    try {
      st = JSON.parse(localStorage.getItem('padelStats') || '{"w":0,"l":0,"xp":0,"level":1,"matches":0,"wins":0,"losses":0}');
    } catch(err) {
      st = {"w":0,"l":0,"xp":0,"level":1,"matches":0,"wins":0,"losses":0};
    }
    st.matches = (st.matches || 0) + 1;
    if (win) {
      st.w = (st.w || 0) + 1;
      st.wins = (st.wins || 0) + 1;
      st.xp = (st.xp || 0) + 500;
    } else {
      st.l = (st.l || 0) + 1;
      st.losses = (st.losses || 0) + 1;
      st.xp = (st.xp || 0) + 150;
    }
    let lvl = st.level || 1;
    let req = lvl * 1000;
    while (st.xp >= req) {
      st.xp -= req;
      lvl++;
      req = lvl * 1000;
    }
    st.level = lvl;
    localStorage.setItem('padelStats', JSON.stringify(st));

    try {
      const p = JSON.parse(localStorage.getItem('padelPlayerData'));
      if (p) {
        p.xp = st.xp;
        p.level = st.level;
        localStorage.setItem('padelPlayerData', JSON.stringify(p));
      }
    } catch(err2) {}
  }catch(e){}
  setTimeout(()=>showResult(win),1800);
}

function showResult(isWin){
  const sc=GS.score;
  const setTxt=GS.completedSets.map(s=>s.t1+'-'+s.t2).join(' | ');
  document.getElementById('result-title').innerHTML=isWin?'<span style="color:#FFD700">&#127942; ¡VICTORIA!</span>':'<span style="color:#f44336">&#128544; DERROTA</span>';
  document.getElementById('result-score').textContent=sc.team1.sets+' - '+sc.team2.sets+'   ('+setTxt+')';
  document.getElementById('result-stats').innerHTML='<div class="stat-card"><div class="stat-value">'+GS.matchWinners[0]+'</div><div class="stat-label">TUS GOLPES</div></div><div class="stat-card"><div class="stat-value">'+GS.matchWinners[1]+'</div><div class="stat-label">RIVALES</div></div>';
  document.getElementById('point-overlay').style.display='none';
  document.getElementById('result-overlay').style.display='flex';
}

function resetAfterPoint(){
  if(GS.phase==='MATCH_OVER')return;
  GS.phase='WAITING_TO_SERVE';GS.ballBounces=0;GS.lastHitTeam=-1;
  GS.pointPending=false;ballHitCooldown=0;powerHeld=0;isCharging=false;
  hitQ=lobQ=smashQ=false;GS.servingRight=!GS.servingRight;
  resetPlayersDefault();resetBall();showServeOverlay();updateScoreboard();
  document.getElementById('point-overlay').style.display='none';
}

function resetBall(){
  const s=P[GS.servingPlayer];
  ballBody.position.set(s.pos.x,0.4,s.pos.z);
  ballBody.velocity.set(0,0,0);ballBody.angularVelocity.set(0,0,0);
  ballBody.force.set(0,0,0);
}

function resetPlayersDefault(){
  P[0].pos.set(1.5,0,-7);P[1].pos.set(-1.5,0,-7);P[2].pos.set(-1.5,0,7);P[3].pos.set(1.5,0,7);
  P.forEach(p=>{p.hitCooldown=0;p.swingAnim=0;});
}

/* =====================================================
   HUD
===================================================== */
function updateScoreboard(){
  const sc=GS.score,d=GS.isDeuce,av=GS.advantage;
  let p1,p2;
  if(GS.isTiebreak){p1=sc.team1.pts;p2=sc.team2.pts;}
  else if(d){p1=av===0?'A':'40';p2=av===1?'A':'40';}
  else{p1=PL[Math.min(sc.team1.pts,3)];p2=PL[Math.min(sc.team2.pts,3)];}
  document.getElementById('team1-points').textContent=p1;
  document.getElementById('team2-points').textContent=p2;
  document.getElementById('team1-games').textContent=sc.team1.games;
  document.getElementById('team2-games').textContent=sc.team2.games;
  document.getElementById('set-indicator').textContent='SET '+(GS.currentSet+1);
  const s1c=document.getElementById('team1-sets'),s2c=document.getElementById('team2-sets');
  s1c.innerHTML='';s2c.innerHTML='';
  GS.completedSets.forEach(s=>{
    s1c.innerHTML+='<span class="set-score-badge">'+s.t1+'</span>';
    s2c.innerHTML+='<span class="set-score-badge">'+s.t2+'</span>';
  });
}

function updateHUD(dt){
